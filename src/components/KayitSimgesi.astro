---
import type { BolumAnahtari } from '../lib/bolumler';
import { kayitSimgesi } from '../lib/kayitSimgeleri';

interface Props {
  bolum: BolumAnahtari;
  slug: string;
  sinif?: string;
}

const { bolum, slug, sinif } = Astro.props;
const cizim = kayitSimgesi(bolum, slug);
---

{
  cizim && (
    <svg
      class:list={['kayit-simgesi', sinif]}
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={cizim}
    />
  )
}

<style>
  .kayit-simgesi {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
