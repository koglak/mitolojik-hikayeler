---
import DurumSimgesi from './DurumSimgesi.astro';
import type { DurumAnahtari } from '../lib/antikKaynaklar';

interface Props {
  ad: string;
  aciklama: string;
  adres: string;
  durum?: DurumAnahtari;
}

const { ad, aciklama, adres, durum } = Astro.props;
---

<li>
  <a href={adres}>
    <strong>
      {ad}
      {durum && <DurumSimgesi durum={durum} />}
    </strong>
    <span class="aciklama">{aciklama}</span>
  </a>
</li>

<style>
  a {
    display: block;
    height: 100%;
    padding: 14px 16px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-left: 2px solid var(--vurgu);
    transition: border-color 0.2s;
  }
  a:hover {
    border-color: var(--vurgu);
  }
  strong {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
    font: 500 22px/1.15 var(--baslik-font);
    margin-bottom: 4px;
  }
  .aciklama {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.45;
    color: var(--soluk);
  }
</style>
