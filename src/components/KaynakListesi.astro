---
import KaynakKarti from './KaynakKarti.astro';
import type { DurumAnahtari } from '../lib/antikKaynaklar';

interface Props {
  baslik: string;
  kimlik: string;
  ogeler: { ad: string; aciklama: string; adres: string; durum?: DurumAnahtari }[];
}

const { baslik, kimlik, ogeler } = Astro.props;
const acikSayisi = 12;
const ilkOgeler = ogeler.slice(0, acikSayisi);
const kalanOgeler = ogeler.slice(acikSayisi);
---

<section aria-labelledby={kimlik}>
  <h2 id={kimlik}>{baslik}</h2>
  <ul>
    {ilkOgeler.map((oge) => <KaynakKarti {...oge} />)}
  </ul>
  {
    kalanOgeler.length > 0 && (
      <details>
        <summary>Kalan {kalanOgeler.length} sayfayı göster</summary>
        <ul>
          {kalanOgeler.map((oge) => (
            <KaynakKarti {...oge} />
          ))}
        </ul>
      </details>
    )
  }
</section>

<style>
  section {
    margin-top: 56px;
    border-top: 1px solid var(--cizgi);
    padding-top: 28px;
  }
  h2 {
    font: 500 30px/1.1 var(--baslik-font);
    margin: 0 0 20px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 12px;
  }
  details {
    margin-top: 12px;
  }
  summary {
    display: inline-block;
    padding: 10px 0;
    color: var(--vurgu);
    cursor: pointer;
  }
  details[open] summary {
    margin-bottom: 6px;
  }
</style>
