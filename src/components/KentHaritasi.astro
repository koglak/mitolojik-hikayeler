---
import type { Bolge } from '../lib/bolgeler';

interface HaritaKenti {
  ad: string;
  ozet: string;
  adres: string;
  enlem: number;
  boylam: number;
  bolge: Bolge & { anahtar: string };
  tanrilar?: string[];
}

interface Props {
  kentler: HaritaKenti[];
  tanriSimgeleri?: Record<string, string>;
}

const { kentler, tanriSimgeleri = {} } = Astro.props;

const googleEarthAdresi = (enlem: number, boylam: number) =>
  `https://earth.google.com/web/@${enlem},${boylam},150a,1800d,35y,0h,55t,0r`;

const haritaVerisi = kentler.map((kent) => ({ ...kent, earth: googleEarthAdresi(kent.enlem, kent.boylam) }));

const gorunenBolgeler = [
  ...new Map(kentler.map((kent) => [kent.bolge.anahtar, kent.bolge])).values(),
].map((bolge) => ({
  ...bolge,
  kentSayisi: kentler.filter((kent) => kent.bolge.anahtar === bolge.anahtar).length,
}));
---

<section class="kent-haritasi" aria-labelledby="harita-basligi">
  <div class="harita-ust">
    <h2 id="harita-basligi">Haritada kentler</h2>
    <p>Bir işarete dokun; kenti oku ya da Google Earth'te 3B olarak gez.</p>
  </div>
  <div class="bolge-aciklamasi" role="group" aria-label="Bölgeleri göster ya da gizle">
    {
      gorunenBolgeler.map((bolge) => (
        <button type="button" class="bolge-dugmesi" data-bolge={bolge.anahtar} aria-pressed="true" style={`--bolge-rengi: ${bolge.renk}`}>
          <span class="bolge-noktasi" aria-hidden="true" />
          {bolge.ad}
          <span class="bolge-sayisi">{bolge.kentSayisi}</span>
        </button>
      ))
    }
  </div>
  <div class="harita-cercevesi">
    <div class="harita" data-kentler={JSON.stringify(haritaVerisi)} data-tanri-simgeleri={JSON.stringify(tanriSimgeleri)} role="region" aria-label="Antik kentlerin uydu haritası"></div>
  </div>
</section>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface IsaretliKent {
    ad: string;
    ozet: string;
    adres: string;
    enlem: number;
    boylam: number;
    earth: string;
    bolge: { anahtar: string; ad: string; renk: string };
    tanrilar?: string[];
  }

  const metniGuvenliYap = (metin: string) =>
    metin.replace(/[&<>"']/g, (karakter) => `&#${karakter.charCodeAt(0)};`);

  for (const bolum of document.querySelectorAll<HTMLElement>('.kent-haritasi')) {
    const haritaAlani = bolum.querySelector<HTMLElement>('.harita');
    if (!haritaAlani) continue;

    const kentler: IsaretliKent[] = JSON.parse(haritaAlani.dataset.kentler ?? '[]');
    const tanriSimgeleri: Record<string, string> = JSON.parse(haritaAlani.dataset.tanriSimgeleri ?? '{}');
    const harita = L.map(haritaAlani, { scrollWheelZoom: false, worldCopyJump: true });

    L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
      { maxZoom: 18, attribution: 'Görüntü © Esri, Maxar, Earthstar Geographics' },
    ).addTo(harita);
    L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
      { maxZoom: 18, opacity: 0.8 },
    ).addTo(harita);

    const isaretler: {
      adres: string;
      bolge: string;
      tanrilar: string[];
      isaret: L.Marker;
      duzIsaret: L.DivIcon;
      renk: string;
    }[] = [];
    let seciliTanri: string | null = null;

    const tanriIsareti = (renk: string, tanri: string) =>
      L.divIcon({
        className: 'kent-isareti kent-isareti-tanrili',
        html: `<span style="--bolge-rengi: ${renk}"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${tanriSimgeleri[tanri] ?? ''}</svg></span>`,
        iconSize: [34, 34],
        iconAnchor: [17, 17],
        popupAnchor: [0, -18],
      });
    const gorunurBolgeler = new Set(kentler.map((kent) => kent.bolge.anahtar));
    let eslesenAdresler: Set<string> | null = null;

    const noktalar = kentler.map((kent) => {
      const nokta = L.latLng(kent.enlem, kent.boylam);
      const isaret = L.divIcon({
        className: 'kent-isareti',
        html: `<span style="--bolge-rengi: ${kent.bolge.renk}"></span>`,
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -12],
      });

      const isaretci = L.marker(nokta, { icon: isaret, title: kent.ad, alt: kent.ad })
        .addTo(harita)
        .bindTooltip(metniGuvenliYap(kent.ad), { direction: 'top', offset: [0, -12], className: 'kent-etiketi' })
        .bindPopup(
          `<span class="pencere-bolgesi" style="--bolge-rengi: ${kent.bolge.renk}">${metniGuvenliYap(kent.bolge.ad)}</span>
           <strong>${metniGuvenliYap(kent.ad)}</strong>
           <p>${metniGuvenliYap(kent.ozet)}</p>
           <div class="baglantilar">
             <a href="${kent.adres}">Kenti oku →</a>
             <a href="${kent.earth}" target="_blank" rel="noopener noreferrer">Google Earth ↗</a>
           </div>`,
          { className: 'kent-penceresi', maxWidth: 280 },
        );
      isaretler.push({
        adres: kent.adres,
        bolge: kent.bolge.anahtar,
        tanrilar: kent.tanrilar ?? [],
        isaret: isaretci,
        duzIsaret: isaret,
        renk: kent.bolge.renk,
      });
      return nokta;
    });

    const isaretleriGuncelle = (gorunenlereYaklas: boolean) => {
      const gorunenNoktalar: L.LatLng[] = [];
      for (const { adres, bolge, tanrilar, isaret, duzIsaret, renk } of isaretler) {
        isaret.setIcon(seciliTanri && tanrilar.includes(seciliTanri) ? tanriIsareti(renk, seciliTanri) : duzIsaret);
        const gorunur = gorunurBolgeler.has(bolge) && (!eslesenAdresler || eslesenAdresler.has(adres));
        if (gorunur) {
          isaret.addTo(harita);
          gorunenNoktalar.push(isaret.getLatLng());
        } else {
          isaret.remove();
        }
      }
      if (gorunenlereYaklas && gorunenNoktalar.length > 0) {
        harita.fitBounds(L.latLngBounds(gorunenNoktalar), { padding: [40, 40], maxZoom: 10 });
      }
    };

    document.addEventListener('kentler-suzuldu', (olay) => {
      const { eslesenAdresler: adresler, tanri } = (
        olay as CustomEvent<{ eslesenAdresler: string[] | null; tanri?: string | null }>
      ).detail;
      eslesenAdresler = adresler ? new Set(adresler) : null;
      seciliTanri = tanri ?? null;
      isaretleriGuncelle(true);
    });

    if (noktalar.length > 0) {
      harita.fitBounds(L.latLngBounds(noktalar), { padding: [40, 40], maxZoom: 9 });
    } else {
      harita.setView([38.5, 27.5], 6);
    }

    for (const dugme of bolum.querySelectorAll<HTMLButtonElement>('.bolge-dugmesi')) {
      dugme.addEventListener('click', () => {
        const bolge = dugme.dataset.bolge ?? '';
        const gorunur = gorunurBolgeler.has(bolge);
        if (gorunur) {
          gorunurBolgeler.delete(bolge);
        } else {
          gorunurBolgeler.add(bolge);
        }
        dugme.setAttribute('aria-pressed', String(!gorunur));
        isaretleriGuncelle(false);
      });
    }

    haritaAlani.addEventListener('click', () => harita.scrollWheelZoom.enable(), { once: true });
  }
</script>

<style>
  .kent-haritasi {
    margin-bottom: 48px;
  }
  .harita-ust {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1;
    margin: 0;
  }
  .harita-ust p {
    color: var(--soluk);
    margin: 0;
    font-size: 15px;
  }
  .bolge-aciklamasi {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .bolge-dugmesi {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    background: var(--yuzey);
    color: var(--yazi);
    border: 1px solid var(--cizgi);
    font: 500 14px/1 var(--govde-font);
    cursor: pointer;
    transition:
      opacity 0.2s,
      border-color 0.2s;
  }
  .bolge-dugmesi:hover,
  .bolge-dugmesi:focus-visible {
    border-color: var(--bolge-rengi);
  }
  .bolge-dugmesi[aria-pressed='false'] {
    opacity: 0.45;
  }
  .bolge-dugmesi[aria-pressed='false'] .bolge-noktasi {
    background: transparent;
  }
  .bolge-noktasi {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bolge-rengi);
    border: 2px solid var(--bolge-rengi);
  }
  .bolge-sayisi {
    color: var(--soluk);
    font-size: 12px;
  }
  .harita-cercevesi {
    border: 1px solid var(--cizgi);
    background: var(--yuzey);
  }
  .harita {
    height: clamp(340px, 58vh, 560px);
    background: var(--hero);
  }
</style>

<style is:global>
  .kent-haritasi .kent-isareti span {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--bolge-rengi, var(--vurgu));
    border: 3px solid var(--zemin);
    box-shadow:
      0 0 0 2px var(--bolge-rengi, var(--vurgu)),
      0 4px 14px rgba(0, 0, 0, 0.6);
    transition: transform 0.2s var(--yumusak);
  }
  .kent-haritasi .kent-isareti-tanrili span {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--zemin);
  }
  .kent-haritasi .kent-isareti-tanrili svg {
    width: 20px;
    height: 20px;
    overflow: visible;
  }
  .kent-haritasi .kent-isareti:hover span,
  .kent-haritasi .kent-isareti:focus-visible span {
    transform: scale(1.25);
  }
  .kent-haritasi .kent-etiketi {
    background: var(--zemin);
    color: var(--yazi);
    border: 1px solid var(--cizgi);
    font: 500 16px/1.2 var(--baslik-font);
    box-shadow: none;
  }
  .kent-haritasi .kent-etiketi::before {
    border-top-color: var(--zemin);
  }
  .kent-haritasi .kent-penceresi .leaflet-popup-content-wrapper,
  .kent-haritasi .kent-penceresi .leaflet-popup-tip {
    background: var(--yuzey);
    color: var(--yazi);
    border-radius: 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .kent-haritasi .kent-penceresi .leaflet-popup-content {
    margin: 16px 18px;
    font: 14px/1.55 var(--govde-font);
  }
  .kent-haritasi .kent-penceresi .pencere-bolgesi {
    display: inline-block;
    margin-bottom: 4px;
    color: var(--bolge-rengi);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .kent-haritasi .kent-penceresi strong {
    display: block;
    font: 500 24px/1.1 var(--baslik-font);
    margin-bottom: 6px;
  }
  .kent-haritasi .kent-penceresi p {
    margin: 0 0 12px;
    color: var(--soluk);
  }
  .kent-haritasi .kent-penceresi .baglantilar {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .kent-haritasi .kent-penceresi a {
    color: var(--vurgu);
  }
  .kent-haritasi .kent-penceresi a.leaflet-popup-close-button {
    color: var(--soluk);
  }
  .kent-haritasi .leaflet-control-attribution {
    background: rgba(16, 21, 28, 0.75);
    color: var(--soluk);
  }
  .kent-haritasi .leaflet-control-attribution a {
    color: var(--yazi);
  }
</style>
