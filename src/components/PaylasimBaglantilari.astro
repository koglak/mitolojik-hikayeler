---
import InstagramSimgesi from './InstagramSimgesi.astro';
import {
  facebookPaylasimAdresi,
  instagramAdresi,
  pinterestPaylasimAdresi,
  whatsappPaylasimAdresi,
  xPaylasimAdresi,
} from '../lib/paylasim';
import { siteAdresi, varsayilanPaylasimGorseli } from '../lib/site';

interface Props {
  adres: string;
  baslik: string;
  gorsel?: string;
  ustBaslik?: string;
}

const { adres, baslik, gorsel = varsayilanPaylasimGorseli, ustBaslik = 'Mitleri paylaş' } = Astro.props;
const gorselAdresi = new URL(gorsel, siteAdresi).href;
---

<section class="paylasim" aria-labelledby="paylasim-basligi">
  <h2 id="paylasim-basligi">{ustBaslik}</h2>
  <ul>
    <li>
      <a href={whatsappPaylasimAdresi(adres, baslik)} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp’ta paylaş (yeni sekmede açılır)" title="WhatsApp’ta paylaş">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M3 21l1.5-4.6A9 9 0 1 1 7.8 19.6Z" />
          <path d="M9 8.2c-.6 3 3.4 7 6.6 6.8l1-1.6-2.2-1.3-1.2 1c-1.2-.5-2-1.4-2.5-2.5l1-1.1-1.1-2.2Z" />
        </svg>
      </a>
    </li>
    <li>
      <a href={xPaylasimAdresi(adres, baslik)} target="_blank" rel="noopener noreferrer" aria-label="X’te paylaş (yeni sekmede açılır)" title="X’te paylaş">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.96 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12Z" />
        </svg>
      </a>
    </li>
    <li>
      <a href={facebookPaylasimAdresi(adres)} target="_blank" rel="noopener noreferrer" aria-label="Facebook’ta paylaş (yeni sekmede açılır)" title="Facebook’ta paylaş">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M14 8.5V6.75c0-.83.55-1.25 1.4-1.25H17V2.2C16.6 2.14 15.5 2 14.4 2 11.9 2 10.2 3.5 10.2 6.3v2.2H7.3V12h2.9v10H14V12h2.8l.5-3.5Z" />
        </svg>
      </a>
    </li>
    <li>
      <a href={pinterestPaylasimAdresi(adres, baslik, gorselAdresi)} target="_blank" rel="noopener noreferrer" aria-label="Pinterest’te paylaş (yeni sekmede açılır)" title="Pinterest’te paylaş">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M9 21.5l3-12" />
          <path d="M7.6 13.4C5.3 9.6 7.6 5 12.2 5c4 0 6 2.9 5.4 6.2-.6 3.4-4 5.2-6.6 3.1" />
        </svg>
      </a>
    </li>
    <li>
      <a
        href={instagramAdresi}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram’da paylaş"
        title="Instagram’da paylaş"
        data-instagram-paylas
        data-adres={adres}
        data-baslik={baslik}
      >
        <InstagramSimgesi />
      </a>
    </li>
  </ul>
  <div role="status">
    <p data-paylasim-durumu hidden>
      <span data-paylasim-kopyalandi hidden>
        Bağlantı kopyalandı. Instagram’da hikâyene ya da mesajına yapıştırabilirsin.
      </span>{' '}
      <span data-paylasim-kopyalanamadi hidden>Bağlantı kopyalanamadı, elle kopyalayabilirsin: {adres}</span>{' '}
      <a href={instagramAdresi} target="_blank" rel="noopener noreferrer">Instagram’ı aç</a>
    </p>
  </div>
</section>

<script>
  import '../scripts/paylasim';
</script>

<style>
  .paylasim {
    padding: 32px 0 8px;
    text-align: center;
  }
  h2 {
    font-size: 26px;
    line-height: 1.2;
    margin: 0 0 18px;
    color: var(--kart-basligi);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  li a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--cizgi);
    border-radius: 50%;
    color: var(--vurgu);
    transition: border-color 0.2s, transform 0.2s var(--yumusak);
  }
  li a:hover {
    border-color: var(--vurgu);
    transform: translateY(-3px);
  }
  svg {
    width: 20px;
    height: 20px;
  }
  p {
    margin: 18px 0 0;
    font-size: 15px;
    color: var(--soluk);
    overflow-wrap: anywhere;
  }
  p a {
    color: var(--vurgu);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
