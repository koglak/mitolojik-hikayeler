---
import Logo from './Logo.astro';
---

<footer class="alt-bilgi">
  <span class="logo">
    <Logo boyut={32} />
    <span class="logo-yazisi" lang="el">ΜΥΘΟΣ</span>
  </span>
  <span>Mitoloji ve antik dünya üzerine bir arşiv.</span>
  <span class="sag">
    <a href="/gizlilik/">Gizlilik ve çerezler</a>
    <span>© {new Date().getFullYear()}</span>
  </span>
</footer>

<style>
  .alt-bilgi {
    border-top: 1px solid var(--cizgi);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 28px 0 40px;
    margin-top: 40px;
    font-size: 14px;
    color: var(--soluk);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sag {
    display: flex;
    gap: 20px;
  }
  .sag a {
    color: var(--soluk);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sag a:hover {
    color: var(--vurgu);
  }
  .logo-yazisi {
    font: 400 22px/1 var(--yunan-font);
    letter-spacing: 0.14em;
    color: var(--yazi);
  }
</style>
