---
interface Props {
  aramaVar?: boolean;
}

const { aramaVar = true } = Astro.props;
import AramaPenceresi from './AramaPenceresi.astro';
import InstagramSimgesi from './InstagramSimgesi.astro';
import Logo from './Logo.astro';
import { antikKaynaklarAdi, antikKaynaklarAdresi } from '../lib/antikKaynaklar';
import { instagramKullaniciAdi, instagramProfilAdresi } from '../lib/site';
import { soyagaciAdresi } from '../lib/soyagaci';
import { sanatAdi, sanatAdresi } from '../lib/sanat';
import { blogAdi, blogAdresi } from '../lib/blog';
import { kronolojiAdresi } from '../lib/zamanAtlasi/adres';

const anaBaglantilar = [
  {
    href: '/mitler/',
    ad: 'Mitler',
    simge:
      '<path d="M24 6h16M26 6v6c-9 3-14 11-14 21 0 13 8 23 20 23s20-10 20-23c0-10-5-18-14-21V6"/>' +
      '<path d="M26 14c-9 0-12 10-6 14M38 14c9 0 12 10 6 14M14 34h36M24 56l-2 4h20l-2-4"/>',
  },
  {
    href: '/tanrilar/',
    ad: 'Tanrılar',
    simge: '<path d="M38 4 18 34h12l-6 26 22-33H33l9-23Z"/>',
  },
  {
    href: '/kahramanlar/',
    ad: 'Kahramanlar',
    simge:
      '<path d="M14 56V36a18 18 0 0 1 36 0v20l-10-5V38h-4v16h-8V38h-4v13Z"/>' +
      '<path d="M12 22C16 6 48 6 52 22"/>',
  },
  {
    href: '/antik-kentler/',
    ad: 'Antik Kentler',
    simge: '<path d="M6 22 32 6l26 16ZM10 28h44M14 28v24M26 28v24M38 28v24M50 28v24M8 52h48M4 58h56"/>',
  },
  {
    href: blogAdresi,
    ad: blogAdi,
    simge: '<path d="M56 6C30 6 14 20 14 46L8 58M56 6c0 24-12 40-42 40M14 46 40 22"/>',
  },
];

const kesfetBaglantilari = [
  {
    href: soyagaciAdresi,
    ad: 'Soyağacı',
    simge:
      '<path d="M22 6h20v12H22ZM6 46h16v12H6ZM24 46h16v12H24ZM42 46h16v12H42Z"/>' +
      '<path d="M32 18v28M14 46V32h36v14"/>',
  },
  {
    href: kronolojiAdresi,
    ad: 'Kronoloji',
    simge: '<path d="M14 4h36M14 60h36M18 4c0 16 28 18 28 28S18 44 18 60M46 4c0 16-28 18-28 28s28 12 28 28"/>',
  },
  {
    href: sanatAdresi,
    ad: sanatAdi,
    simge:
      '<path d="M6 12h52v40H6ZM12 18h40v28H12Z"/><path d="m12 40 11-11 9 9 7-6 13 11M24 12l8-8 8 8"/>',
  },
  {
    href: antikKaynaklarAdresi,
    ad: antikKaynaklarAdi,
    simge:
      '<path d="M16 14v40a6 6 0 0 0 6 6h30a6 6 0 0 1-6-6V10a6 6 0 0 0-6-6H10a6 6 0 0 1 6 6Z"/>' +
      '<path d="M10 4a6 6 0 0 0-6 6v4h12M26 20h12M26 32h12M26 44h8"/>',
  },
  {
    href: '/oyun/',
    ad: 'Oyunlar',
    simge: '<path d="M18 22h28a10 10 0 0 1 10 10v14a8 8 0 0 1-8 8H16a8 8 0 0 1-8-8V32a10 10 0 0 1 10-10Z"/><path d="M20 36h12M26 30v12M42 34h.1M48 40h.1"/>',
  },
];
const simdikiYol = Astro.url.pathname;
const aktifMi = (href: string) => simdikiYol.startsWith(href);
const guncelSayfa = (href: string) => (aktifMi(href) ? ('page' as const) : undefined);
const kesfetAktif = kesfetBaglantilari.some((b) => aktifMi(b.href));
const menuGruplari = [anaBaglantilar, kesfetBaglantilari];
---

<header class="baslik-cubugu">
  <a class="logo" href="/" aria-label="Mythos, ana sayfa">
    <Logo />
    <span class="logo-yazisi" lang="el">ΜΥΘΟΣ<span lang="tr">Mitolojik Hikâyeler</span></span>
  </a>
  <nav class="masaustu-menu" aria-label="Ana menü">
    {
      anaBaglantilar.map((b) => (
        <a class:list={['ust-baglanti', { aktif: aktifMi(b.href) }]} href={b.href} aria-current={guncelSayfa(b.href)}>
          {b.ad}
        </a>
      ))
    }
    <div class="kesfet" data-kesfet>
      <button
        class:list={['ust-baglanti', 'kesfet-dugmesi', { aktif: kesfetAktif }]}
        type="button"
        data-kesfet-dugmesi
        aria-expanded="false"
        aria-controls="kesfet-paneli"
      >
        Keşfet
        <svg class="kesfet-oku" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m2 4 4 4 4-4" /></svg>
      </button>
      <div class="kesfet-paneli" id="kesfet-paneli">
        {
          kesfetBaglantilari.map((b) => (
            <a class:list={['simgeli-baglanti', { aktif: aktifMi(b.href) }]} href={b.href} aria-current={guncelSayfa(b.href)}>
              <svg class="menu-simgesi" viewBox="0 0 64 64" aria-hidden="true" focusable="false" set:html={b.simge} />
              {b.ad}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
  <div class="eylemler">
    {
      aramaVar && (
        <button class="simge-dugmesi" type="button" data-arama-ac aria-label="Hikâye ara" title="Hikâye ara">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.8" />
            <path d="m16 16 5 5" />
          </svg>
        </button>
      )
    }
    <a
      class="simge-dugmesi"
      href={instagramProfilAdresi}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Instagram: @${instagramKullaniciAdi} (yeni sekmede açılır)`}
      title={`Instagram: @${instagramKullaniciAdi}`}
    >
      <InstagramSimgesi boyut={20} kalinlik={1.6} />
    </a>
    <button class="simge-dugmesi menu-dugmesi" type="button" data-menu-ac aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobil-menu">☰</button>
  </div>
  <nav class="mobil-menu" id="mobil-menu" data-mobil-menu aria-label="Mobil menü">
    {
      menuGruplari.map((grup) => (
        <div class="mobil-grup">
          {grup.map((b) => (
            <a class:list={['simgeli-baglanti', { aktif: aktifMi(b.href) }]} href={b.href} aria-current={guncelSayfa(b.href)}>
              <svg class="menu-simgesi" viewBox="0 0 64 64" aria-hidden="true" focusable="false" set:html={b.simge} />
              {b.ad}
            </a>
          ))}
        </div>
      ))
    }
  </nav>
</header>
{aramaVar && <AramaPenceresi />}

<script>
  const menuDugmesi = document.querySelector<HTMLButtonElement>('[data-menu-ac]');
  const mobilMenu = document.querySelector<HTMLElement>('[data-mobil-menu]');
  function menuyuAyarla(acik: boolean): void {
    mobilMenu?.classList.toggle('acik', acik);
    menuDugmesi?.setAttribute('aria-expanded', String(acik));
  }
  menuDugmesi?.addEventListener('click', () => menuyuAyarla(!mobilMenu?.classList.contains('acik')));
  mobilMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menuyuAyarla(false)));

  const kesfet = document.querySelector<HTMLElement>('[data-kesfet]');
  const kesfetDugmesi = kesfet?.querySelector<HTMLButtonElement>('[data-kesfet-dugmesi]');
  const kesfetAcikMi = () => kesfetDugmesi?.getAttribute('aria-expanded') === 'true';
  function kesfetiAyarla(acik: boolean): void {
    kesfetDugmesi?.setAttribute('aria-expanded', String(acik));
  }
  kesfetDugmesi?.addEventListener('click', () => kesfetiAyarla(!kesfetAcikMi()));
  kesfet?.addEventListener('focusout', (olay) => {
    if (olay.relatedTarget && !kesfet.contains(olay.relatedTarget as Node)) kesfetiAyarla(false);
  });
  document.addEventListener('click', (olay) => {
    if (!kesfet?.contains(olay.target as Node)) kesfetiAyarla(false);
  });
  document.addEventListener('keydown', (olay) => {
    if (olay.key !== 'Escape') return;
    if (kesfetAcikMi()) {
      kesfetiAyarla(false);
      kesfetDugmesi?.focus();
    }
    if (mobilMenu?.classList.contains('acik')) {
      menuyuAyarla(false);
      menuDugmesi?.focus();
    }
  });
</script>

<style>
  .baslik-cubugu {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--cizgi);
    position: relative;
    z-index: 5;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }
  .logo-yazisi {
    font-family: var(--yunan-font);
    font-size: 26px;
    font-weight: 400;
    letter-spacing: 0.14em;
    line-height: 1;
  }
  .logo-yazisi span {
    font-family: var(--govde-font);
    display: block;
    font-style: normal;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--soluk);
    margin-top: 4px;
  }
  .masaustu-menu {
    display: flex;
    align-items: center;
    gap: 30px;
    white-space: nowrap;
  }
  .ust-baglanti {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 0;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    font: 500 15px/1.6 var(--govde-font);
    color: var(--soluk);
  }
  .ust-baglanti:hover,
  .ust-baglanti.aktif,
  .kesfet-dugmesi[aria-expanded='true'] {
    color: var(--yazi);
    border-bottom-color: var(--vurgu);
  }
  .kesfet {
    position: relative;
  }
  .kesfet-oku {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }
  .kesfet-dugmesi[aria-expanded='true'] .kesfet-oku {
    transform: rotate(180deg);
  }
  .kesfet-paneli {
    display: none;
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    min-width: 230px;
    flex-direction: column;
    padding: 10px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--vurgu);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    font-size: 15px;
  }
  .kesfet-dugmesi[aria-expanded='true'] + .kesfet-paneli {
    display: flex;
  }
  .kesfet-paneli .simgeli-baglanti {
    padding: 10px 12px;
  }
  .kesfet-paneli .simgeli-baglanti:hover {
    background: var(--yuzey-2);
  }
  .simgeli-baglanti {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .simgeli-baglanti.aktif {
    color: var(--vurgu);
  }
  .menu-simgesi {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--vurgu);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .simgeli-baglanti:hover .menu-simgesi,
  .simgeli-baglanti.aktif .menu-simgesi {
    opacity: 1;
  }
  .eylemler {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .simge-dugmesi {
    background: none;
    border: 0;
    color: var(--yazi);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-size: 20px;
  }
  .menu-dugmesi,
  .mobil-menu {
    display: none;
  }
  @media (max-width: 1000px) {
    .baslik-cubugu {
      height: 72px;
    }
    .masaustu-menu {
      display: none;
    }
    .menu-dugmesi {
      display: grid;
    }
    .mobil-menu.acik {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      background: var(--yuzey);
      border: 1px solid var(--cizgi);
      padding: 22px;
      font-size: 16px;
    }
    .mobil-grup {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .mobil-grup + .mobil-grup {
      margin-top: 22px;
      padding-top: 22px;
      border-top: 1px solid var(--cizgi);
    }
    .logo-yazisi {
      font-size: 22px;
    }
  }
  @media (max-width: 350px) {
    .baslik-cubugu {
      gap: 4px;
    }
    .eylemler {
      gap: 0;
    }
    .simge-dugmesi {
      width: 40px;
    }
  }
</style>
