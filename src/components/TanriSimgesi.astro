---
import { tanriSimgesi } from '../lib/tanriSimgeleri';

interface Props {
  slug: string;
  sinif?: string;
}

const { slug, sinif } = Astro.props;
const cizim = tanriSimgesi(slug);
---

{
  cizim && (
    <svg
      class:list={['tanri-simgesi', sinif]}
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={cizim}
    />
  )
}

<style>
  .tanri-simgesi {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
