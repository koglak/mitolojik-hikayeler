---
import { baglantiCozucu } from '../../lib/zamanAtlasi/baglantilar';
import type { Atlas } from '../../lib/zamanAtlasi/sorgu';
import KayitDetayi from './KayitDetayi.astro';

interface Props {
  atlas: Atlas;
  secili: string;
}

const { atlas, secili } = Astro.props;
const baglantilariCoz = await baglantiCozucu();
---

<aside class="panel" data-detay-paneli aria-label="Seçilen kayıt">
  <button type="button" class="kapat" data-detay-kapat aria-label="Ayrıntıyı kapat">×</button>
  <article class="genel" data-detay-genel hidden>
    <h2 data-genel-baslik></h2>
    <p data-genel-ozet></p>
    <p>Bir şeride, olay işaretine ya da ada dokun; ayrıntısı burada açılsın.</p>
  </article>
  {
    [...atlas.kayitlar.values()].map((oge) => (
      <KayitDetayi atlas={atlas} oge={oge} baglantilar={baglantilariCoz(oge.kayit)} gizli={oge.kayit.kimlik !== secili} />
    ))
  }
</aside>

<style>
  .panel {
    position: relative;
    overflow: auto;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-radius: 4px;
    scrollbar-color: var(--cizgi) transparent;
  }
  .genel {
    padding: 22px;
  }
  .genel h2 {
    font-size: 34px;
    line-height: 1.05;
    margin: 0 0 12px;
    font-variant-numeric: lining-nums;
  }
  .genel p {
    color: var(--soluk);
  }
  .kapat {
    display: none;
  }
  @media (max-width: 1099px) {
    .panel {
      position: fixed;
      z-index: 20;
      inset: auto 0 0;
      max-height: 72vh;
      max-height: 72dvh;
      padding-bottom: env(safe-area-inset-bottom);
      border-radius: 10px 10px 0 0;
      box-shadow: 0 -16px 50px rgba(0, 0, 0, 0.55);
      visibility: hidden;
      transform: translateY(100%);
      transition: transform 0.28s var(--yumusak), visibility 0.28s;
    }
    .panel[data-acik] {
      visibility: visible;
      transform: none;
      transition: transform 0.28s var(--yumusak);
    }
    .kapat {
      position: sticky;
      z-index: 2;
      top: 8px;
      float: right;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin: 8px 8px 0 0;
      font-size: 22px;
      background: var(--yuzey-2);
      border: 1px solid var(--cizgi);
      border-radius: 4px;
    }
  }
</style>
