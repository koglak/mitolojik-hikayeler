---
import type { Nitelik } from '../../lib/zamanAtlasi/etiketler';

interface Props {
  nitelik: Nitelik;
}

const { nitelik } = Astro.props;
---

<svg class:list={['nitelik-isareti', nitelik]} viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
  <path class="dis" d="M8 1.5 14.5 8 8 14.5 1.5 8Z"></path>
  {nitelik === 'tartismali' && <path class="ic" d="M8 5 11 8 8 11 5 8Z" />}
</svg>

<style>
  .nitelik-isareti {
    flex: none;
    display: block;
  }
  .dis {
    fill: var(--yazi);
    stroke: var(--zemin);
    stroke-width: 1;
  }
  .tartismali .dis {
    fill: var(--zemin);
    stroke: var(--yazi);
    stroke-width: 1.4;
  }
  .tartismali .ic {
    fill: var(--yazi);
  }
  .mitolojik .dis {
    fill: var(--zemin);
    stroke: var(--vurgu);
    stroke-width: 1.8;
  }
</style>
