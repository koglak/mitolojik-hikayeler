---
import { nitelikler } from '../../lib/zamanAtlasi/etiketler';
import type { Olay } from '../../lib/zamanAtlasi/sema';
import { aralikYaz } from '../../lib/zamanAtlasi/yil';
import { aralikKonumu, yilKonumu } from '../../lib/zamanAtlasi/konum';
import NitelikIsareti from './NitelikIsareti.astro';

interface Props {
  olay: Olay;
  uygarlikSatirinda?: boolean;
}

const { olay, uygarlikSatirinda = false } = Astro.props;
const [donem] = olay.donemler;
const surer = donem.son > donem.bas;
const isaretKimligi = uygarlikSatirinda ? olay.kimlik : undefined;
const etiket = `${aralikYaz(donem.bas, donem.son)}, ${olay.ad} (${nitelikler[olay.nitelik]})`;
---

{
  surer && (
    <span class="sure-kabi" data-isaret={isaretKimligi}>
      <span class="sure" data-bas={donem.bas} data-son={donem.son} style={aralikKonumu(donem)} />
    </span>
  )
}
<button
  type="button"
  class="isaret"
  data-sec={olay.kimlik}
  data-isaret={isaretKimligi}
  style={yilKonumu(donem.bas)}
  title={etiket}
  aria-label={etiket}
>
  <NitelikIsareti nitelik={olay.nitelik} />
</button>

<style>
  .sure-kabi {
    display: contents;
  }
  .sure {
    --gorunen-bas: max(var(--bas), var(--g-bas));
    --gorunen-son: min(var(--son), var(--g-son));
    position: absolute;
    z-index: 1;
    bottom: 4px;
    left: calc((var(--gorunen-bas) - var(--g-bas)) / (var(--g-son) - var(--g-bas)) * 100%);
    width: calc((var(--gorunen-son) - var(--gorunen-bas)) / (var(--g-son) - var(--g-bas)) * 100%);
    height: 3px;
    background: var(--yazi);
    border-radius: 2px;
    pointer-events: none;
  }
  .isaret {
    position: absolute;
    z-index: 2;
    top: calc(50% - 14px);
    left: calc((var(--konum) - var(--g-bas)) / (var(--g-son) - var(--g-bas)) * 100%);
    display: grid;
    place-items: center;
    width: 24px;
    height: 28px;
    padding: 0;
    background: none;
    border: 0;
    transform: translateX(-50%);
  }
  .isaret:hover,
  .isaret:focus-visible {
    z-index: 3;
  }
  .isaret:focus-visible {
    outline-offset: -2px;
  }
  .isaret:hover :global(svg) {
    transform: scale(1.2);
  }
  .isaret[data-secili] {
    z-index: 3;
  }
  .isaret[data-secili] :global(svg) {
    transform: scale(1.3);
    filter: drop-shadow(0 0 4px var(--vurgu)) drop-shadow(0 0 1px var(--vurgu));
  }
</style>
