---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/gfs-didot/400.css';
import '../styles/tema.css';
import { olcumAnahtari } from '../lib/olcum';
import { rssAdresi } from '../lib/rss';
import { gorselTuru, mutlakAdres, sayfaBasligi, siteAdi, siteAdresi, siteKisaAdi, varsayilanPaylasimGorseli } from '../lib/site';
import { blogAdi } from '../lib/blog';
import { paylasimGenisligi, paylasimYuksekligi } from '../lib/paylasimGorseli';

interface Props {
  baslik?: string;
  aciklama: string;
  gorsel?: string;
  gorselAciklamasi?: string;
  gorselBoyutu?: { genislik: number; yukseklik: number };
  tur?: 'website' | 'article';
  yapisalVeri?: Record<string, unknown>[];
  dizinlenmesin?: boolean;
}

const {
  baslik,
  aciklama,
  gorsel = varsayilanPaylasimGorseli,
  gorselAciklamasi = siteAdi,
  gorselBoyutu = { genislik: paylasimGenisligi, yukseklik: paylasimYuksekligi },
  tur = 'website',
  yapisalVeri = [],
  dizinlenmesin = false,
} = Astro.props;

const tamBaslik = sayfaBasligi(baslik);
const kanonikAdres = mutlakAdres(Astro.url.pathname);
const gorselAdresi = new URL(gorsel, siteAdresi).href;
const yapisalVeriMetni = yapisalVeri.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': yapisalVeri }).replaceAll('<', '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    {dizinlenmesin ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={kanonikAdres} />}
    <meta property="og:site_name" content={siteAdi} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={tur} />
    <meta property="og:title" content={baslik ?? siteAdi} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={kanonikAdres} />
    <meta property="og:image" content={gorselAdresi} />
    <meta property="og:image:type" content={gorselTuru(gorsel)} />
    <meta property="og:image:width" content={String(gorselBoyutu.genislik)} />
    <meta property="og:image:height" content={String(gorselBoyutu.yukseklik)} />
    <meta property="og:image:alt" content={gorselAciklamasi} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={baslik ?? siteAdi} />
    <meta name="twitter:description" content={aciklama} />
    <meta name="twitter:image" content={gorselAdresi} />
    <meta name="application-name" content={siteKisaAdi} />
    <meta name="theme-color" content="#10151c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteAdi} · ${blogAdi}`} href={rssAdresi} />
    {yapisalVeriMetni && <script type="application/ld+json" is:inline set:html={yapisalVeriMetni} />}
    <meta name="google-adsense-account" content="ca-pub-8518261734381602" />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8518261734381602"
      crossorigin="anonymous"></script>
    {
      olcumAnahtari && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: olcumAnahtari })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
