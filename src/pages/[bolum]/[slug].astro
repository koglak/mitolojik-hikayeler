---
import { getCollection, render } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import SiteBasligi from '../../components/SiteBasligi.astro';
import SiteAltBilgisi from '../../components/SiteAltBilgisi.astro';
import MitGorseli from '../../components/MitGorseli.astro';
import { bolumAnahtarlari, bolumler, bolumAdresi, kayitAdresi, mitAdresi } from '../../lib/bolumler';
import { basligiBol } from '../../lib/baslikParcalari';
import KayitSimgesi from '../../components/KayitSimgesi.astro';
import { kayitSimgesi } from '../../lib/kayitSimgeleri';
import KayitKarti from '../../components/KayitKarti.astro';
import SanattaBolumu from '../../components/SanattaBolumu.astro';
import MeanderBant from '../../components/MeanderBant.astro';
import { bolgeler } from '../../lib/bolgeler';
import { ilgiliKayitlar } from '../../lib/iliskiler';
import { bagliKaynak } from '../../lib/kaynakDizini';
import hamSoyagaci from '../../data/soyagaci.json';
import { kayittanKisi, kisiAdresi } from '../../lib/soyagaci';
import type { Soyagaci } from '../../lib/soyagaciSemasi';
import { kayitPaylasimGorseli } from '../../lib/paylasimGorseli';
import { kirintiVerisi, konuVerisi, makaleVerisi } from '../../lib/yapisalVeri';

export async function getStaticPaths() {
  const yollar = [];
  for (const bolum of bolumAnahtarlari) {
    const kayitlar = (await getCollection(bolum)).sort((a, b) => a.data.sira - b.data.sira);
    for (const kayit of kayitlar) {
      yollar.push({
        params: { bolum: bolumler[bolum].yol, slug: kayit.id },
        props: {
          bolum,
          kayit,
          ayniBolgedekiler:
            bolum === 'kentler' && kayit.data.bolge
              ? kayitlar.filter((diger) => diger.id !== kayit.id && diger.data.bolge === kayit.data.bolge)
              : [],
        },
      });
    }
  }
  return yollar;
}

const { bolum, kayit, ayniBolgedekiler } = Astro.props;
const kentSayfasi = bolum === 'kentler';
const soyagacindakiKisi = bolum === 'kentler' ? undefined : kayittanKisi(hamSoyagaci as unknown as Soyagaci, bolum, kayit.id);
const kaynakParcalari = await bagliKaynak(kayit.data.kaynak);
const ilgiliGruplar = await ilgiliKayitlar(bolum, kayit.id);
const tanrininTapinaklari =
  bolum === 'tanrilar'
    ? (await getCollection('kentler'))
        .sort((a, b) => a.data.sira - b.data.sira)
        .flatMap((kent) =>
          kent.data.tapinaklar
            .filter((tapinak) => tapinak.tanrilar.includes(kayit.id))
            .map((tapinak) => ({ ad: tapinak.ad, kent })),
        )
    : [];
const kentinBolgesi = kayit.data.bolge ? bolgeler[kayit.data.bolge] : undefined;
const { Content } = await render(kayit);
const simgeVar = Boolean(kayitSimgesi(bolum, kayit.id));
const mitler = await getCollection('mitler');
const ilgiliMitler = kayit.data.ilgiliMitler
  .map((slug: string) => mitler.find((mit) => mit.id === slug))
  .filter((mit): mit is (typeof mitler)[number] => Boolean(mit));
const paylasimGorseli = kayitPaylasimGorseli(bolum, kayit.id);
const yapisalVeri = [
  makaleVerisi({
    baslik: kayit.data.ad,
    aciklama: kayit.data.ozet,
    yol: kayitAdresi(bolum, kayit.id),
    gorsel: paylasimGorseli,
    bolum: bolumler[bolum].ad,
    konu: konuVerisi(kayit.data.ad, kayit.data.konum),
  }),
  kirintiVerisi([
    { ad: bolumler[bolum].ad, yol: bolumAdresi(bolum) },
    { ad: kayit.data.ad, yol: kayitAdresi(bolum, kayit.id) },
  ]),
];
---

<Temel
  baslik={`${kayit.data.ad} · ${bolumler[bolum].ad}`}
  aciklama={kayit.data.ozet}
  tur="article"
  gorsel={paylasimGorseli}
  gorselAciklamasi={kayit.data.ad}
  yapisalVeri={yapisalVeri}
>
  <div class="site-kabugu">
    <SiteBasligi />
    <main class="kayit">
      <nav class="yol" aria-label="Konum">
        <a href={bolumAdresi(bolum)}>{bolumler[bolum].ad}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{kayit.data.ad}</span>
      </nav>

      <header class:list={{ 'simgeli': simgeVar }}>
        <div>
          <h1>{kayit.data.ad}</h1>
          <p class="ozet">{kayit.data.ozet}</p>
        </div>
        {
          simgeVar && (
            <div class="madalyon">
              <KayitSimgesi bolum={bolum} slug={kayit.id} />
            </div>
          )
        }
      </header>

      <div class="duzen">
        <aside class="kunye" aria-label="Künye">
          <dl>
            {
              kayit.data.bilgiler.map((bilgi: { etiket: string; deger: string }) => (
                <div>
                  <dt>{bilgi.etiket}</dt>
                  <dd>{bilgi.deger}</dd>
                </div>
              ))
            }
          </dl>
          {
            kayit.data.tapinaklar.length > 0 && (
              <div class="tapinaklar">
                <span>Tapınaklar</span>
                <ul>
                  {kayit.data.tapinaklar.map((tapinak: { ad: string; tanrilar: string[] }) => (
                    <li>
                      <a href={kayitAdresi('tanrilar', tapinak.tanrilar[0])}>{tapinak.ad}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <p class="kaynak"><span>Kaynak</span>{kaynakParcalari.map(({ metin, adres }) => (adres ? <a href={adres}>{metin}</a> : metin))}</p>
          {soyagacindakiKisi && <a class="soyagaci-baglantisi" href={kisiAdresi(soyagacindakiKisi)}>Soyağacında gör</a>}
        </aside>

        <article class="metin">
          <Content />
        </article>
      </div>

      {
        ilgiliMitler.length > 0 && (
          <section class="ilgili" aria-labelledby="ilgili-baslik">
            <h2 id="ilgili-baslik">Bu konudaki hikâyeler</h2>
            <ul>
              {ilgiliMitler.map((mit) => {
                const { ad, altBaslik } = basligiBol(mit.data.baslik);
                return (
                  <li>
                    <a href={mitAdresi(mit.id)}>
                      <span class="ilgili-resmi">
                        <MitGorseli slug={mit.id} idEki={`ilgili-${kayit.id}`} />
                      </span>
                      <span class="ilgili-metni">
                        <strong>{ad}</strong>
                        <span>{altBaslik}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      <SanattaBolumu alan={bolum} kimlik={kayit.id} />

      {
        tanrininTapinaklari.length > 0 && (
          <section class="baglantilar" aria-labelledby="tapinaklar-baslik">
            <h2 id="tapinaklar-baslik">{kayit.data.ad} tapınakları</h2>
            <ul>
              {tanrininTapinaklari.map(({ ad, kent }) => {
                const kentBolgesi = kent.data.bolge ? bolgeler[kent.data.bolge] : undefined;
                return (
                  <li>
                    <a href={kayitAdresi('kentler', kent.id)}>
                      <strong>{ad}</strong>
                      <span>{kentBolgesi ? `${kent.data.ad} · ${kentBolgesi.ad}` : kent.data.ad}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        ilgiliGruplar.map((grup) => (
          <section class="baglantilar" aria-labelledby={`baglanti-${grup.bolum}`}>
            <h2 id={`baglanti-${grup.bolum}`}>İlgili {bolumler[grup.bolum].ad.toLocaleLowerCase('tr')}</h2>
            <ul>
              {grup.kayitlar.map((bagli) => {
                const bagliBolge = grup.bolum === 'kentler' && bagli.data.bolge ? bolgeler[bagli.data.bolge] : undefined;
                return (
                  <li>
                    <a href={kayitAdresi(grup.bolum, bagli.id)}>
                      <strong>
                        {bagliBolge && <span class="bolge-noktasi" style={`--bolge-rengi: ${bagliBolge.renk}`} aria-hidden="true" />}
                        {bagli.data.ad}
                      </strong>
                      <span>{bagli.data.ozet}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }

      {
        kentinBolgesi && ayniBolgedekiler.length > 0 && (
          <section class="ayni-bolge" aria-labelledby="ayni-bolge-baslik" style={`--bolge-rengi: ${kentinBolgesi.renk}`}>
            <h2 id="ayni-bolge-baslik">
              <span class="bolge-noktasi" aria-hidden="true" />
              {kentinBolgesi.ad} bölgesindeki diğer kentler
            </h2>
            <ul>
              {ayniBolgedekiler.map((kent) => (
                <li>
                  <KayitKarti adres={kayitAdresi(bolum, kent.id)} kayit={kent.data} bilgiSayisi={3} vurguRengi={kentinBolgesi.renk} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        !kentSayfasi && (
          <div class="kapanis-deseni">
            <MeanderBant kimlik="kayit-kapanis" />
          </div>
        )
      }
    </main>
    <SiteAltBilgisi />
  </div>
</Temel>

<style>
  .kayit {
    padding: 40px 0 0;
  }
  .yol {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--soluk);
    margin-bottom: 28px;
  }
  .yol a {
    border-bottom: 1px solid var(--vurgu);
  }
  h1 {
    font: 500 clamp(56px, 9vw, 120px) / 0.92 var(--baslik-font);
    letter-spacing: -0.04em;
    margin: 0 0 18px;
  }
  .ozet {
    font: italic 400 clamp(22px, 3vw, 30px) / 1.35 var(--baslik-font);
    color: var(--vurgu);
    max-width: 38rem;
    margin: 0 0 48px;
  }
  .simgeli {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: start;
  }
  .madalyon {
    width: 168px;
    height: 168px;
    padding: 34px;
    border: 1px solid var(--cizgi);
    border-radius: 50%;
    outline: 1px solid var(--cizgi);
    outline-offset: 8px;
    background: radial-gradient(circle, var(--parilti), transparent 70%), var(--yuzey);
    color: var(--vurgu);
    margin-top: 8px;
  }
  .duzen {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    border-top: 1px solid var(--cizgi);
    padding-top: 40px;
  }
  .kunye {
    position: sticky;
    top: 24px;
    padding: 24px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--vurgu);
  }
  .kunye dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .kunye dt {
    font-size: 12px;
    color: var(--soluk);
    margin-bottom: 2px;
  }
  .kunye dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .tapinaklar {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--cizgi);
  }
  .tapinaklar span {
    display: block;
    font-size: 12px;
    color: var(--soluk);
    margin-bottom: 8px;
  }
  .tapinaklar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 15px;
    line-height: 1.4;
  }
  .tapinaklar a {
    border-bottom: 1px solid var(--cizgi);
  }
  .tapinaklar a:hover {
    border-bottom-color: var(--vurgu);
  }
  .kaynak {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--cizgi);
    font: italic 400 17px/1.45 var(--baslik-font);
    color: var(--vurgu);
  }
  .kaynak span {
    display: block;
    font: 400 12px/1.4 var(--govde-font);
    color: var(--soluk);
    margin-bottom: 4px;
  }
  .kaynak a {
    border-bottom: 1px solid var(--cizgi);
  }
  .kaynak a:hover {
    border-bottom-color: var(--vurgu);
  }
  .soyagaci-baglantisi {
    display: inline-block;
    margin-top: 18px;
    border-bottom: 1px solid var(--vurgu);
  }
  .metin {
    max-width: 40rem;
    font: 400 21px/1.75 var(--baslik-font);
  }
  .metin :global(p) {
    margin: 0 0 1.1em;
  }
  .metin :global(p:first-child::first-letter) {
    float: left;
    font-size: 4.2em;
    line-height: 0.8;
    padding: 6px 10px 0 0;
    color: var(--vurgu);
  }
  .ilgili {
    margin-top: 64px;
    border-top: 1px solid var(--cizgi);
    padding-top: 32px;
  }
  .ilgili h2 {
    font: 500 36px/1.1 var(--baslik-font);
    margin: 0 0 24px;
  }
  .ilgili ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .ilgili a {
    display: block;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    transition: border-color 0.2s;
  }
  .ilgili a:hover {
    border-color: var(--vurgu);
  }
  .ilgili-resmi {
    display: block;
    height: 150px;
    overflow: hidden;
  }
  .ilgili-resmi :global(.mit-gorseli) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ilgili-metni {
    display: block;
    padding: 16px 18px 18px;
  }
  .ilgili-metni strong {
    display: block;
    font: 500 26px/1.1 var(--baslik-font);
  }
  .ilgili-metni span {
    font: italic 400 17px/1.3 var(--baslik-font);
    color: var(--vurgu);
  }
  .baglantilar {
    margin-top: 56px;
    border-top: 1px solid var(--cizgi);
    padding-top: 28px;
  }
  .baglantilar h2 {
    font: 500 30px/1.1 var(--baslik-font);
    margin: 0 0 20px;
  }
  .baglantilar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }
  .baglantilar a {
    display: block;
    height: 100%;
    padding: 14px 16px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-left: 2px solid var(--vurgu);
    transition: border-color 0.2s;
  }
  .baglantilar a:hover {
    border-color: var(--vurgu);
  }
  .baglantilar strong {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 500 22px/1.15 var(--baslik-font);
    margin-bottom: 4px;
  }
  .baglantilar strong .bolge-noktasi {
    width: 9px;
    height: 9px;
  }
  .baglantilar a > span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.45;
    color: var(--soluk);
  }
  .ayni-bolge {
    margin-top: 64px;
    border-top: 1px solid var(--cizgi);
    padding-top: 32px;
  }
  .ayni-bolge h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 500 36px/1.1 var(--baslik-font);
    margin: 0 0 24px;
  }
  .bolge-noktasi {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bolge-rengi);
    flex-shrink: 0;
  }
  .ayni-bolge ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1050px) {
    .ayni-bolge ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 740px) {
    .ayni-bolge ul {
      grid-template-columns: 1fr;
    }
  }
  .kapanis-deseni {
    margin-top: 64px;
  }
  @media (max-width: 640px) {
    .simgeli {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .madalyon {
      grid-row: 1;
      width: 108px;
      height: 108px;
      padding: 22px;
      margin: 0 0 28px 8px;
    }
  }
  @media (max-width: 900px) {
    .duzen {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .kunye {
      position: static;
    }
    .metin {
      font-size: 19px;
    }
  }
</style>
