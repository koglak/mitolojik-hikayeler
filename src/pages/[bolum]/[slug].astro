---
import { getCollection, render } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import SiteBasligi from '../../components/SiteBasligi.astro';
import SiteAltBilgisi from '../../components/SiteAltBilgisi.astro';
import MitGorseli from '../../components/MitGorseli.astro';
import { bolumAnahtarlari, bolumler, bolumAdresi, kayitAdresi } from '../../lib/bolumler';
import { basligiBol } from '../../lib/baslikParcalari';
import KayitSimgesi from '../../components/KayitSimgesi.astro';
import { kayitSimgesi } from '../../lib/kayitSimgeleri';

export async function getStaticPaths() {
  const yollar = [];
  for (const bolum of bolumAnahtarlari) {
    const kayitlar = (await getCollection(bolum)).sort((a, b) => a.data.sira - b.data.sira);
    for (const [i, kayit] of kayitlar.entries()) {
      yollar.push({
        params: { bolum: bolumler[bolum].yol, slug: kayit.id },
        props: { bolum, kayit, sonraki: kayitlar[(i + 1) % kayitlar.length] },
      });
    }
  }
  return yollar;
}

const { bolum, kayit, sonraki } = Astro.props;
const { Content } = await render(kayit);
const simgeVar = Boolean(kayitSimgesi(bolum, kayit.id));
const mitler = await getCollection('mitler');
const ilgiliMitler = kayit.data.ilgiliMitler
  .map((slug: string) => mitler.find((mit) => mit.id === slug))
  .filter((mit): mit is (typeof mitler)[number] => Boolean(mit));
---

<Temel baslik={`${kayit.data.ad} · ${bolumler[bolum].ad} · Mythos`} aciklama={kayit.data.ozet}>
  <div class="site-kabugu">
    <SiteBasligi />
    <main class="kayit">
      <nav class="yol" aria-label="Konum">
        <a href={bolumAdresi(bolum)}>{bolumler[bolum].ad}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{kayit.data.ad}</span>
      </nav>

      <header class:list={{ 'simgeli': simgeVar }}>
        <div>
          <h1>{kayit.data.ad}</h1>
          <p class="ozet">{kayit.data.ozet}</p>
        </div>
        {
          simgeVar && (
            <div class="madalyon">
              <KayitSimgesi bolum={bolum} slug={kayit.id} />
            </div>
          )
        }
      </header>

      <div class="duzen">
        <aside class="kunye" aria-label="Künye">
          <dl>
            {
              kayit.data.bilgiler.map((bilgi: { etiket: string; deger: string }) => (
                <div>
                  <dt>{bilgi.etiket}</dt>
                  <dd>{bilgi.deger}</dd>
                </div>
              ))
            }
          </dl>
          <p class="kaynak"><span>Kaynak</span>{kayit.data.kaynak}</p>
        </aside>

        <article class="metin">
          <Content />
        </article>
      </div>

      {
        ilgiliMitler.length > 0 && (
          <section class="ilgili" aria-labelledby="ilgili-baslik">
            <h2 id="ilgili-baslik">Bu konudaki hikâyeler</h2>
            <ul>
              {ilgiliMitler.map((mit) => {
                const { ad, altBaslik } = basligiBol(mit.data.baslik);
                return (
                  <li>
                    <a href={`/mitler/${mit.id}`}>
                      <span class="ilgili-resmi">
                        <MitGorseli slug={mit.id} idEki={`ilgili-${kayit.id}`} />
                      </span>
                      <span class="ilgili-metni">
                        <strong>{ad}</strong>
                        <span>{altBaslik}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        sonraki.id !== kayit.id && (
          <a class="sonraki" href={kayitAdresi(bolum, sonraki.id)}>
            <span>Sıradaki</span>
            <strong>{sonraki.data.ad}</strong>
          </a>
        )
      }
    </main>
    <SiteAltBilgisi />
  </div>
</Temel>

<style>
  .kayit {
    padding: 40px 0 0;
  }
  .yol {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--soluk);
    margin-bottom: 28px;
  }
  .yol a {
    border-bottom: 1px solid var(--vurgu);
  }
  h1 {
    font: 500 clamp(56px, 9vw, 120px) / 0.92 var(--baslik-font);
    letter-spacing: -0.04em;
    margin: 0 0 18px;
  }
  .ozet {
    font: italic 400 clamp(22px, 3vw, 30px) / 1.35 var(--baslik-font);
    color: var(--vurgu);
    max-width: 38rem;
    margin: 0 0 48px;
  }
  .simgeli {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: start;
  }
  .madalyon {
    width: 168px;
    height: 168px;
    padding: 34px;
    border: 1px solid var(--cizgi);
    border-radius: 50%;
    outline: 1px solid var(--cizgi);
    outline-offset: 8px;
    background: radial-gradient(circle, var(--parilti), transparent 70%), var(--yuzey);
    color: var(--vurgu);
    margin-top: 8px;
  }
  .duzen {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    border-top: 1px solid var(--cizgi);
    padding-top: 40px;
  }
  .kunye {
    position: sticky;
    top: 24px;
    padding: 24px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--vurgu);
  }
  .kunye dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .kunye dt {
    font-size: 12px;
    color: var(--soluk);
    margin-bottom: 2px;
  }
  .kunye dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .kaynak {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--cizgi);
    font: italic 400 17px/1.45 var(--baslik-font);
    color: var(--vurgu);
  }
  .kaynak span {
    display: block;
    font: 400 12px/1.4 var(--govde-font);
    color: var(--soluk);
    margin-bottom: 4px;
  }
  .metin {
    max-width: 40rem;
    font: 400 21px/1.75 var(--baslik-font);
  }
  .metin :global(p) {
    margin: 0 0 1.1em;
  }
  .metin :global(p:first-child::first-letter) {
    float: left;
    font-size: 4.2em;
    line-height: 0.8;
    padding: 6px 10px 0 0;
    color: var(--vurgu);
  }
  .ilgili {
    margin-top: 64px;
    border-top: 1px solid var(--cizgi);
    padding-top: 32px;
  }
  .ilgili h2 {
    font: 500 36px/1.1 var(--baslik-font);
    margin: 0 0 24px;
  }
  .ilgili ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .ilgili a {
    display: block;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    transition: border-color 0.2s;
  }
  .ilgili a:hover {
    border-color: var(--vurgu);
  }
  .ilgili-resmi {
    display: block;
    height: 150px;
    overflow: hidden;
  }
  .ilgili-resmi :global(.mit-gorseli) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ilgili-metni {
    display: block;
    padding: 16px 18px 18px;
  }
  .ilgili-metni strong {
    display: block;
    font: 500 26px/1.1 var(--baslik-font);
  }
  .ilgili-metni span {
    font: italic 400 17px/1.3 var(--baslik-font);
    color: var(--vurgu);
  }
  .sonraki {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-top: 56px;
    padding: 24px 0;
    border-top: 1px solid var(--cizgi);
    text-align: right;
  }
  .sonraki span {
    font-size: 13px;
    color: var(--soluk);
  }
  .sonraki strong {
    font: 500 40px/1.1 var(--baslik-font);
  }
  .sonraki:hover strong {
    color: var(--vurgu);
  }
  @media (max-width: 640px) {
    .simgeli {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .madalyon {
      grid-row: 1;
      width: 108px;
      height: 108px;
      padding: 22px;
      margin: 0 0 28px 8px;
    }
  }
  @media (max-width: 900px) {
    .duzen {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .kunye {
      position: static;
    }
    .metin {
      font-size: 19px;
    }
  }
</style>
