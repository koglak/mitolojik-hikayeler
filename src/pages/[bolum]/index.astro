---
import { getCollection } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import SiteBasligi from '../../components/SiteBasligi.astro';
import SiteAltBilgisi from '../../components/SiteAltBilgisi.astro';
import KayitKarti from '../../components/KayitKarti.astro';
import KategoriGorseli from '../../components/KategoriGorseli.astro';
import KentHaritasi from '../../components/KentHaritasi.astro';
import KayitSimgesi from '../../components/KayitSimgesi.astro';
import { kayitSimgesi } from '../../lib/kayitSimgeleri';
import { bolumAnahtarlari, bolumler, bolumAdresi, kayitAdresi } from '../../lib/bolumler';
import { bolgeAnahtarlari, bolgeler, bolgesizKent } from '../../lib/bolgeler';
import { aramaIcinSadelestir } from '../../lib/aramaMetni';
import { kirintiVerisi, koleksiyonVerisi } from '../../lib/yapisalVeri';

export function getStaticPaths() {
  return bolumAnahtarlari.map((bolum) => ({ params: { bolum: bolumler[bolum].yol }, props: { bolum } }));
}

const { bolum } = Astro.props;
const { ad, aciklama } = bolumler[bolum];
const kayitlar = (await getCollection(bolum)).sort((a, b) => a.data.sira - b.data.sira);
const bolgeRengi = (kayit: (typeof kayitlar)[number]) => (kayit.data.bolge ? bolgeler[kayit.data.bolge].renk : undefined);
const haritaKentleri =
  bolum === 'kentler'
    ? kayitlar.flatMap(({ id, data }) =>
        data.konum
          ? [
              {
                ad: data.ad,
                ozet: data.ozet,
                adres: kayitAdresi(bolum, id),
                ...data.konum,
                bolge: data.bolge ? { anahtar: data.bolge, ...bolgeler[data.bolge] } : bolgesizKent,
              },
            ]
          : [],
      )
    : [];
const bolgeGruplari = kayitlar.some((kayit) => kayit.data.bolge)
  ? [
      ...bolgeAnahtarlari.map((anahtar) => ({
        baslik: bolgeler[anahtar].ad,
        renk: bolgeler[anahtar].renk,
        kayitlar: kayitlar.filter((kayit) => kayit.data.bolge === anahtar),
      })),
      { baslik: 'Diğer', renk: undefined, kayitlar: kayitlar.filter((kayit) => !kayit.data.bolge) },
    ].filter((grup) => grup.kayitlar.length > 0)
  : [];
const aramaOrnekleri: Partial<Record<typeof bolum, string>> = {
  kentler: 'Kentlerde ara: Efes, Likya, Bodrum, Medusa...',
  tanrilar: 'Tanrılarda ara: Zeus, deniz, Titan...',
  kahramanlar: 'Kahramanlarda ara: Herakles, Truva, Amazon...',
};
const aramaOrnegi = aramaOrnekleri[bolum];
const yapisalVeri = [
  koleksiyonVerisi({
    ad,
    aciklama,
    yol: bolumAdresi(bolum),
    ogeler: kayitlar.map((kayit) => ({ ad: kayit.data.ad, yol: kayitAdresi(bolum, kayit.id) })),
  }),
  kirintiVerisi([{ ad, yol: bolumAdresi(bolum) }]),
];
const aranacakMetin = (kayit: (typeof kayitlar)[number]) =>
  aramaIcinSadelestir(
    [
      kayit.data.ad,
      kayit.data.ozet,
      kayit.data.bolge ? bolgeler[kayit.data.bolge].ad : '',
      ...kayit.data.bilgiler.flatMap((bilgi) => [bilgi.etiket, bilgi.deger]),
    ].join(' '),
  );
---

<Temel baslik={ad} aciklama={aciklama} yapisalVeri={yapisalVeri}>
  <div class="site-kabugu">
    <SiteBasligi />
    <main>
      <header class="bolum-girisi">
        <div class="bolum-metni">
          <h1>{ad}</h1>
          <p>{aciklama}</p>
        </div>
        <div class="bolum-resmi"><KategoriGorseli tur={bolum} /></div>
      </header>
      {
        aramaOrnegi && (
          <>
            <label class="arama">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <circle cx="10.8" cy="10.8" r="6.8" />
                <path d="m16 16 5 5" />
              </svg>
              <input type="search" data-kayit-ara placeholder={aramaOrnegi} autocomplete="off" aria-label={`${ad} içinde ara`} />
            </label>
            <p class="sonuc-yok gizli" data-sonuc-yok aria-live="polite">
              Bu aramayla eşleşen kayıt yok.
            </p>
          </>
        )
      }
      {haritaKentleri.length > 0 && <KentHaritasi kentler={haritaKentleri} />}
      {
        bolgeGruplari.length > 0 ? (
          bolgeGruplari.map((grup) => (
            <section class="bolge-grubu" data-bolge-grubu style={grup.renk ? `--bolge-rengi: ${grup.renk}` : undefined}>
              <h2>
                <span class="bolge-noktasi" aria-hidden="true" />
                {grup.baslik}
                <span class="bolge-sayisi">{grup.kayitlar.length} kent</span>
              </h2>
              <ul class="kayitlar">
                {grup.kayitlar.map((kayit) => (
                  <li data-aranan={aramaOrnegi ? aranacakMetin(kayit) : undefined} data-adres={kayitAdresi(bolum, kayit.id)}>
                    <KayitKarti adres={kayitAdresi(bolum, kayit.id)} kayit={kayit.data} bilgiSayisi={3} vurguRengi={bolgeRengi(kayit)} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        ) : (
          <ul class="kayitlar">
            {kayitlar.map((kayit) => (
              <li data-aranan={aramaOrnegi ? aranacakMetin(kayit) : undefined}>
                <KayitKarti adres={kayitAdresi(bolum, kayit.id)} kayit={kayit.data} bilgiSayisi={3}>
                  {kayitSimgesi(bolum, kayit.id) && <KayitSimgesi slot="simge" bolum={bolum} slug={kayit.id} />}
                </KayitKarti>
              </li>
            ))}
          </ul>
        )
      }
    </main>
    <SiteAltBilgisi />
  </div>
</Temel>

<script>
  import { aramaIcinSadelestir } from '../../lib/aramaMetni';

  const kutu = document.querySelector<HTMLInputElement>('[data-kayit-ara]');
  const ogeler = Array.from(document.querySelectorAll<HTMLElement>('[data-aranan]'));
  const sonucYok = document.querySelector<HTMLElement>('[data-sonuc-yok]');
  const bolgeGruplari = Array.from(document.querySelectorAll<HTMLElement>('[data-bolge-grubu]'));
  kutu?.addEventListener('input', () => {
    const aranan = aramaIcinSadelestir(kutu.value.trim());
    let gorunen = 0;
    for (const oge of ogeler) {
      const eslesir = (oge.dataset.aranan ?? '').includes(aranan);
      oge.classList.toggle('gizli', !eslesir);
      if (eslesir) gorunen += 1;
    }
    sonucYok?.classList.toggle('gizli', gorunen > 0);
    for (const grup of bolgeGruplari) {
      grup.classList.toggle('gizli', !grup.querySelector('[data-aranan]:not(.gizli)'));
    }
    const eslesenAdresler = aranan
      ? ogeler.filter((oge) => !oge.classList.contains('gizli')).flatMap((oge) => oge.dataset.adres ?? [])
      : null;
    document.dispatchEvent(new CustomEvent('kentler-suzuldu', { detail: { eslesenAdresler } }));
  });
</script>

<style>
  .arama {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 560px;
    padding: 0 16px;
    margin-bottom: 28px;
    border: 1px solid var(--cizgi);
    background: var(--yuzey);
    color: var(--soluk);
    transition: border-color 0.2s;
  }
  .arama:focus-within {
    border-color: var(--vurgu);
  }
  .arama input {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 16px;
  }
  .arama input::placeholder {
    color: var(--soluk);
  }
  .sonuc-yok {
    color: var(--soluk);
    font: italic 400 20px/1.4 var(--baslik-font);
    margin: 0 0 28px;
  }
  .bolum-girisi {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--cizgi);
    margin-bottom: 40px;
  }
  .bolum-metni {
    min-width: 0;
  }
  h1 {
    font: 500 clamp(52px, 7vw, 96px) / 0.95 var(--baslik-font);
    letter-spacing: -0.035em;
    margin: 0 0 20px;
  }
  .bolum-metni p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--soluk);
    max-width: 30rem;
    margin: 0;
  }
  .bolum-resmi {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--cizgi);
  }
  .bolge-grubu + .bolge-grubu {
    margin-top: 48px;
  }
  .bolge-grubu h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    margin: 0 0 20px;
  }
  .bolge-noktasi {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bolge-rengi, var(--vurgu));
    flex: none;
  }
  .bolge-sayisi {
    font: 400 14px/1 var(--govde-font);
    color: var(--soluk);
  }
  .kayitlar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1050px) {
    .kayitlar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 740px) {
    .bolum-girisi {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 36px;
    }
    .kayitlar {
      grid-template-columns: 1fr;
    }
  }
</style>
