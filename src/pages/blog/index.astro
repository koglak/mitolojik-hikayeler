---
import Temel from '../../layouts/Temel.astro';
import SiteBasligi from '../../components/SiteBasligi.astro';
import SiteAltBilgisi from '../../components/SiteAltBilgisi.astro';
import YaziMasasi from '../../components/YaziMasasi.astro';
import YaziKarti from '../../components/YaziKarti.astro';
import { blogYazilariniGetir } from '../../lib/blogDizini';
import { blogAciklamasi, blogAdi, blogAdresi, yaziAdresi } from '../../lib/blog';
import { sayfaBoyu } from '../../lib/blogSorgu';
import { aramaIcinSadelestir } from '../../lib/aramaMetni';
import { kirintiVerisi, koleksiyonVerisi } from '../../lib/yapisalVeri';

const yazilar = await blogYazilariniGetir();
const aranacakMetin = ({ data }: (typeof yazilar)[number]) =>
  aramaIcinSadelestir([data.baslik, data.konu, data.ozet].join(' '));
const yapisalVeri = [
  koleksiyonVerisi({
    ad: blogAdi,
    aciklama: blogAciklamasi,
    yol: blogAdresi,
    ogeler: yazilar.map((yazi) => ({ ad: yazi.data.baslik, yol: yaziAdresi(yazi.id) })),
  }),
  kirintiVerisi([{ ad: blogAdi, yol: blogAdresi }]),
];
---

<Temel
  baslik="Antik Dünya Blogu"
  aciklama={blogAciklamasi}
  yapisalVeri={yapisalVeri}
>
  <div class="site-kabugu">
    <SiteBasligi />
    <main>
      <header class="giris">
        <div>
          <h1>{blogAdi}</h1>
          <p>{blogAciklamasi}</p>
        </div>
        <div class="giris-resmi"><YaziMasasi kimlik="giris-yazi" /></div>
      </header>

      <div class="arama-alani" role="search" aria-label="Blog yazılarında ara">
        <label class="arama">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.8"></circle>
            <path d="m16 16 5 5"></path>
          </svg>
          <input type="search" data-blog-ara placeholder="Yazı ya da konu ara" autocomplete="off" aria-label="Blog yazılarında ara" />
        </label>
      </div>

      <p class="sonuc" aria-live="polite" tabindex="-1" data-blog-sonucu>{yazilar.length} yazı</p>
      <div class="sonuc-yok gizli" data-blog-sonuc-yok>
        <p>Bu aramayla eşleşen yazı yok.</p>
        <button type="button" class="dugme-cizgili">Aramayı temizle</button>
      </div>

      <ul class="yazilar" aria-label="Blog yazıları" data-blog-listesi>
        {
          yazilar.map((yazi, sira) => (
            <li class:list={{ gizli: sira >= sayfaBoyu }} data-aranan={aranacakMetin(yazi)}>
              <YaziKarti yazi={yazi} />
            </li>
          ))
        }
      </ul>

      <nav class="sayfalar gizli" aria-label="Blog sayfaları" data-blog-sayfalari></nav>
      <noscript>
        <style is:inline>
          .yazilar > li.gizli {
            display: block !important;
          }
          .arama-alani {
            display: none;
          }
        </style>
      </noscript>
    </main>
    <SiteAltBilgisi />
  </div>
</Temel>

<script>
  import '../../scripts/blog';
</script>

<style>
  .giris {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--cizgi);
    margin-bottom: 32px;
  }
  .giris > * {
    min-width: 0;
  }
  h1 {
    font: 500 clamp(52px, 7vw, 96px) / 0.95 var(--baslik-font);
    letter-spacing: -0.035em;
    margin: 0 0 20px;
  }
  .giris p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--soluk);
    max-width: 30rem;
    margin: 0;
  }
  .giris-resmi {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--cizgi);
  }
  .arama {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    min-height: 52px;
    border: 1px solid var(--cizgi);
    background: var(--yuzey);
    color: var(--soluk);
    transition: border-color 0.2s;
  }
  .arama:focus-within {
    border-color: var(--vurgu);
  }
  .arama input {
    flex: 1;
    min-width: 0;
    min-height: 50px;
    border: 0;
    outline: 0;
    background: transparent;
    font: 16px var(--govde-font);
    color: var(--yazi);
  }
  .arama input::placeholder {
    color: var(--soluk);
  }
  .sonuc {
    margin: 22px 0 16px;
    font-size: 14px;
    color: var(--soluk);
    scroll-margin-top: 20px;
  }
  .sonuc-yok {
    margin-bottom: 28px;
  }
  .sonuc-yok p {
    font: italic 400 20px/1.4 var(--baslik-font);
    color: var(--soluk);
    margin: 0 0 14px;
  }
  .yazilar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 20px;
  }
  .sayfalar {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 40px;
  }
  .sayfalar :global(a),
  .sayfalar :global(span) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 1 44px;
    min-width: 0;
    min-height: 44px;
    font: 500 15px/1 var(--govde-font);
  }
  .sayfalar :global(a) {
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    transition: border-color 0.2s;
  }
  .sayfalar :global(a:hover) {
    border-color: var(--vurgu);
  }
  .sayfalar :global(a[aria-current='page']) {
    background: var(--vurgu);
    border-color: var(--vurgu);
    color: var(--zemin);
  }
  @media (max-width: 740px) {
    .giris {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 36px;
    }
    .sayfalar {
      gap: 4px;
    }
  }
</style>
