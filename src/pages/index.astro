---
import Temel from '../layouts/Temel.astro';
import SiteBasligi from '../components/SiteBasligi.astro';
import SiteAltBilgisi from '../components/SiteAltBilgisi.astro';
import MansetSlider from '../components/MansetSlider.astro';
import AnasayfaSecmeleri from '../components/AnasayfaSecmeleri.astro';
import KategoriGorseli, { type KategoriTuru } from '../components/KategoriGorseli.astro';
import OzluSozler from '../components/OzluSozler.astro';
import PapirusRafi from '../components/PapirusRafi.astro';
import SanatSalonu from '../components/SanatSalonu.astro';
import YaziMasasi from '../components/YaziMasasi.astro';
import PaylasimBaglantilari from '../components/PaylasimBaglantilari.astro';
import { antikKaynaklarAdi, antikKaynaklarAdresi } from '../lib/antikKaynaklar';
import { bolumler } from '../lib/bolumler';
import { sanatAdi, sanatAdresi } from '../lib/sanat';
import { soyagaciAdresi } from '../lib/soyagaci';
import { mutlakAdres, sayfaBasligi } from '../lib/site';
import { siteVerisi } from '../lib/yapisalVeri';
import { blogAdi, blogAdresi } from '../lib/blog';
import { kronolojiAdresi } from '../lib/zamanAtlasi/adres';


const baslik = 'Yunan Mitleri, Tanrılar, Kahramanlar ve Antik Kentler';

const kategoriler: { tur: KategoriTuru | 'kaynaklar' | 'sanat' | 'blog'; ad: string; adres: string }[] = [
  { tur: 'mitler', ad: 'Mitolojik Hikâyeler', adres: '/mitler/' },
  { tur: 'kentler', ad: bolumler.kentler.ad, adres: '/antik-kentler/' },
  { tur: 'tanrilar', ad: bolumler.tanrilar.ad, adres: '/tanrilar/' },
  { tur: 'kahramanlar', ad: bolumler.kahramanlar.ad, adres: '/kahramanlar/' },
  { tur: 'soyagaci', ad: 'Soyağacı', adres: soyagaciAdresi },
  { tur: 'kaynaklar', ad: antikKaynaklarAdi, adres: antikKaynaklarAdresi },
  { tur: 'kronoloji', ad: 'Kronoloji', adres: kronolojiAdresi },
  { tur: 'sanat', ad: sanatAdi, adres: sanatAdresi },
  { tur: 'blog', ad: blogAdi, adres: blogAdresi },
];
---

<Temel
  baslik={baslik}
  aciklama="Yunan mitleri, antik kentler, tanrılar ve kahramanlar. Kısa hikâyeler ve kaynaklı künyeler."
  yapisalVeri={siteVerisi()}
>
  <div class="site-kabugu">
    <SiteBasligi />
  </div>

  <div class="site-kabugu">
    <main>
      <h1>Mitler, <em>kentler</em> ve kahramanlar.</h1>
      <MansetSlider />
      <AnasayfaSecmeleri />

      <ul class="kategoriler" aria-label="Bölümler">
        {
          kategoriler.map((kategori) => (
            <li class:list={{ genis: kategori.tur === 'blog' }}>
              <a class="kategori" href={kategori.adres}>
                <span class="kategori-resmi">
                  {kategori.tur === 'kaynaklar' && <PapirusRafi />}
                  {kategori.tur === 'sanat' && <SanatSalonu kimlik="anasayfa" />}
                  {kategori.tur === 'blog' && <YaziMasasi kimlik="anasayfa-yazi" />}
                  {kategori.tur !== 'kaynaklar' && kategori.tur !== 'sanat' && kategori.tur !== 'blog' && <KategoriGorseli tur={kategori.tur} />}
                </span>
                <span class="kategori-adi">{kategori.ad}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <OzluSozler />

      <PaylasimBaglantilari adres={mutlakAdres('/')} baslik={sayfaBasligi(baslik)} />
    </main>

    <SiteAltBilgisi />
  </div>

</Temel>

<script>
  import '../scripts/anasayfa';
</script>

<style>
  h1 {
    font: 500 clamp(36px, 5vw, 68px) / 1 var(--baslik-font);
    letter-spacing: -0.035em;
    margin: 32px 0 24px;
  }
  h1 em {
    font-weight: 400;
    color: var(--vurgu);
  }

  .kategoriler {
    list-style: none;
    margin: 0;
    padding: 64px 0 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .kategori {
    display: block;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    transition: border-color 0.25s, transform 0.25s var(--yumusak);
  }
  .kategori:hover {
    border-color: var(--vurgu);
    transform: translateY(-4px);
  }
  .kategori-resmi {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .kategori-resmi :global(svg) {
    transition: transform 0.6s var(--yumusak);
  }
  .kategori:hover .kategori-resmi :global(svg) {
    transform: scale(1.05);
  }
  .kategori-adi {
    display: block;
    padding: 18px 22px 20px;
    font: 500 30px/1.1 var(--baslik-font);
    color: var(--kart-basligi);
    border-top: 2px solid var(--vurgu);
  }

  @media (max-width: 1050px) {
    .kategoriler {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .genis {
      grid-column: 1 / -1;
    }
    .genis .kategori-resmi {
      aspect-ratio: 2 / 1;
    }
  }
  @media (max-width: 560px) {
    .genis .kategori-resmi {
      aspect-ratio: 3 / 2;
    }
    .kategoriler {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-top: 40px;
    }
    .kategori-adi {
      font-size: 28px;
    }
  }
</style>
