---
import { getCollection, render } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import SiteBasligi from '../../components/SiteBasligi.astro';
import SiteAltBilgisi from '../../components/SiteAltBilgisi.astro';
import MeanderBant from '../../components/MeanderBant.astro';
import MitGorseli from '../../components/MitGorseli.astro';
import SanatGorseli from '../../components/SanatGorseli.astro';
import SanatKarti from '../../components/SanatKarti.astro';
import { basligiBol } from '../../lib/baslikParcalari';
import { bolumAnahtarlari, bolumler, kayitAdresi, mitAdresi } from '../../lib/bolumler';
import { bagliKaynak } from '../../lib/kaynakDizini';
import { gorselKokenleri, sanatAdi, sanatAdresi, sanatEserAdresi, sanatTurleri } from '../../lib/sanat';
import { muzeler, sanatEserleriniGetir } from '../../lib/sanatDizini';
import { baglantiAlanlari } from '../../lib/sanatSorgu';
import { varsayilanPaylasimGorseli } from '../../lib/site';
import { kirintiVerisi, makaleVerisi, sanatEseriVerisi } from '../../lib/yapisalVeri';

export async function getStaticPaths() {
  const eserler = await sanatEserleriniGetir();
  return eserler.map((eser) => ({
    params: { slug: eser.id },
    props: {
      eser,
      ayniMuzedekiler: eserler.filter((diger) => diger.id !== eser.id && diger.data.muze === eser.data.muze),
    },
  }));
}

const { eser, ayniMuzedekiler } = Astro.props;
const { data } = eser;
const { Content } = await render(eser);
const muze = muzeler[data.muze];
const muzeHaritaAdresi = `https://www.google.com/maps/search/?api=1&query=${muze.enlem},${muze.boylam}`;
const kaynakParcalari = data.kaynak ? await bagliKaynak(data.kaynak) : [];
const sanatciYazilsin = data.sanatci ?? 'Bilinmiyor';
const kunye = [
  { etiket: 'Sanatçı', deger: sanatciYazilsin },
  { etiket: 'Tarih', deger: data.tarih },
  { etiket: 'Tür', deger: sanatTurleri[data.tur] },
  { etiket: 'Malzeme', deger: data.malzeme },
  ...(data.ozgunAd ? [{ etiket: 'Özgün adı', deger: data.ozgunAd }] : []),
];
const tumMitler = await getCollection('mitler');
const ilgiliMitler = tumMitler
  .filter((mit) => data.ilgiliMitler.includes(mit.id))
  .sort((a, b) => a.data.sira - b.data.sira);
const ilgiliGruplar = (
  await Promise.all(
    bolumAnahtarlari.map(async (bolum) => {
      const kimlikler: string[] = data[baglantiAlanlari[bolum]];
      const kayitlar = (await getCollection(bolum)).filter((kayit) => kimlikler.includes(kayit.id));
      return { bolum, kayitlar: kayitlar.sort((a, b) => a.data.sira - b.data.sira) };
    }),
  )
).filter((grup) => grup.kayitlar.length > 0);
const paylasimGorseli = data.gorsel?.adres ?? varsayilanPaylasimGorseli;
const yol = sanatEserAdresi(eser.id);
const eserVerisi = sanatEseriVerisi({
  ad: data.ad,
  aciklama: data.ozet,
  yol,
  tur: sanatTurleri[data.tur],
  malzeme: data.malzeme,
  tarih: data.tarih,
  muze,
  sanatci: data.sanatci,
  gorsel: data.gorsel?.adres,
});
const yapisalVeri = [
  makaleVerisi({
    baslik: data.ad,
    aciklama: data.ozet,
    yol,
    gorsel: paylasimGorseli,
    bolum: sanatAdi,
    konu: eserVerisi,
  }),
  kirintiVerisi([
    { ad: sanatAdi, yol: sanatAdresi },
    { ad: data.ad, yol },
  ]),
];
---

<Temel
  baslik={`${data.ad} · ${sanatAdi}`}
  aciklama={data.ozet}
  tur="article"
  gorsel={paylasimGorseli}
  gorselBoyutu={data.gorsel}
  gorselAciklamasi={data.gorsel?.alt ?? data.ad}
  yapisalVeri={yapisalVeri}
  onBaglantilar={gorselKokenleri([eser])}
>
  <div class="site-kabugu">
    <SiteBasligi />
    <main class="eser">
      <nav class="yol" aria-label="Konum">
        <a href={sanatAdresi}>{sanatAdi}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{data.ad}</span>
      </nav>

      <header>
        <h1>{data.ad}</h1>
        <p class="ozet">{data.ozet}</p>
      </header>

      <figure class="buyuk-gorsel">
        <SanatGorseli eser={eser} boyut="sayfa" />
        {
          data.gorsel && (
            <figcaption>
              Görsel: {data.gorsel.sahibi},{' '}
              {data.gorsel.lisansAdresi ? (
                <a href={data.gorsel.lisansAdresi} target="_blank" rel="noopener noreferrer">
                  {data.gorsel.lisans}
                </a>
              ) : (
                data.gorsel.lisans
              )}
              ,{' '}
              <a href={data.gorsel.kaynakAdresi} target="_blank" rel="noopener noreferrer">
                Wikimedia Commons
              </a>
            </figcaption>
          )
        }
      </figure>

      <div class="duzen">
        <aside class="kunye" aria-label="Künye">
          <dl>
            {
              kunye.map(({ etiket, deger }) => (
                <div>
                  <dt>{etiket}</dt>
                  <dd>{deger}</dd>
                </div>
              ))
            }
          </dl>
          <div class="nerede">
            <h2>Bugün nerede?</h2>
            <strong>{muze.ad}</strong>
            <span>{muze.kent === muze.ulke ? muze.kent : `${muze.kent}, ${muze.ulke}`}</span>
            {data.konumNotu && <p>{data.konumNotu}</p>}
            <a href={muzeHaritaAdresi} target="_blank" rel="noopener noreferrer">Haritada aç ↗</a>
          </div>
          {
            kaynakParcalari.length > 0 && (
              <p class="kaynak">
                <span>Antik kaynak</span>
                {kaynakParcalari.map(({ metin, adres }) => (adres ? <a href={adres}>{metin}</a> : metin))}
              </p>
            )
          }
        </aside>

        <article class="metin">
          <Content />
          <section class="kaynakca" aria-labelledby="kaynakca-baslik">
            <h2 id="kaynakca-baslik">Kaynaklar</h2>
            <ul>
              {
                data.kaynakca.map((kaynak) => (
                  <li>
                    <a href={kaynak.adres} target="_blank" rel="noopener noreferrer">{kaynak.ad}</a>
                  </li>
                ))
              }
            </ul>
          </section>
        </article>
      </div>

      {
        ilgiliMitler.length > 0 && (
          <section class="ilgili" aria-labelledby="ilgili-baslik">
            <h2 id="ilgili-baslik">Hikâyesini oku</h2>
            <ul>
              {ilgiliMitler.map((mit) => {
                const { ad, altBaslik } = basligiBol(mit.data.baslik);
                return (
                  <li>
                    <a href={mitAdresi(mit.id)}>
                      <span class="ilgili-resmi">
                        <MitGorseli slug={mit.id} idEki={`sanat-${eser.id}`} />
                      </span>
                      <span class="ilgili-metni">
                        <strong>{ad}</strong>
                        <span>{altBaslik}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        ilgiliGruplar.map((grup) => (
          <section class="baglantilar" aria-labelledby={`baglanti-${grup.bolum}`}>
            <h2 id={`baglanti-${grup.bolum}`}>İlgili {bolumler[grup.bolum].ad.toLocaleLowerCase('tr')}</h2>
            <ul>
              {grup.kayitlar.map((kayit) => (
                <li>
                  <a href={kayitAdresi(grup.bolum, kayit.id)}>
                    <strong>{kayit.data.ad}</strong>
                    <span>{kayit.data.ozet}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        ayniMuzedekiler.length > 0 && (
          <section class="ayni-muze" aria-labelledby="ayni-muze-baslik">
            <h2 id="ayni-muze-baslik">Aynı müzede: {muze.ad}</h2>
            <ul>
              {ayniMuzedekiler.map((diger) => (
                <li>
                  <SanatKarti eser={diger} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="kapanis-deseni"><MeanderBant kimlik="eser-kapanis" /></div>
    </main>
    <SiteAltBilgisi />
  </div>
</Temel>

<style>
  .eser {
    padding: 40px 0 0;
  }
  .yol {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 14px;
    color: var(--soluk);
    margin-bottom: 28px;
  }
  .yol a {
    border-bottom: 1px solid var(--vurgu);
  }
  h1 {
    font: 500 clamp(44px, 7.5vw, 104px) / 0.95 var(--baslik-font);
    letter-spacing: -0.035em;
    margin: 0 0 18px;
  }
  .ozet {
    font: italic 400 clamp(22px, 3vw, 30px) / 1.35 var(--baslik-font);
    color: var(--vurgu);
    max-width: 44rem;
    margin: 0 0 36px;
  }
  .buyuk-gorsel {
    margin: 0 0 48px;
    background: var(--hero);
    border: 1px solid var(--cizgi);
  }
  figcaption {
    padding: 12px 16px;
    border-top: 1px solid var(--cizgi);
    font-size: 13px;
    color: var(--soluk);
    overflow-wrap: anywhere;
  }
  figcaption a {
    border-bottom: 1px solid var(--cizgi);
  }
  figcaption a:hover {
    color: var(--vurgu);
  }
  .duzen {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .kunye {
    position: sticky;
    top: 24px;
    padding: 24px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-top: 2px solid var(--vurgu);
  }
  .kunye dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .kunye dt {
    font-size: 12px;
    color: var(--soluk);
    margin-bottom: 2px;
  }
  .kunye dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .nerede {
    display: grid;
    gap: 4px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--cizgi);
    font-size: 15px;
  }
  .nerede h2 {
    font: 400 12px/1.4 var(--govde-font);
    color: var(--soluk);
    margin: 0;
  }
  .nerede strong {
    font: 500 24px/1.1 var(--baslik-font);
    color: var(--kart-basligi);
  }
  .nerede p {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--soluk);
  }
  .nerede a {
    justify-self: start;
    margin-top: 8px;
    border-bottom: 1px solid var(--vurgu);
  }
  .kaynak {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--cizgi);
    font: italic 400 17px/1.45 var(--baslik-font);
    color: var(--vurgu);
  }
  .kaynak span {
    display: block;
    font: 400 12px/1.4 var(--govde-font);
    color: var(--soluk);
    margin-bottom: 4px;
  }
  .kaynak a {
    border-bottom: 1px solid var(--cizgi);
  }
  .metin {
    max-width: 40rem;
    font: 400 21px/1.75 var(--baslik-font);
  }
  .metin :global(h2) {
    font: 500 36px/1.1 var(--baslik-font);
    color: var(--kart-basligi);
    margin: 1.4em 0 0.5em;
  }
  .metin > :global(h2:first-child) {
    margin-top: 0;
  }
  .metin :global(p) {
    margin: 0 0 1.1em;
  }
  .kaynakca {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--cizgi);
    font: 400 15px/1.6 var(--govde-font);
  }
  .metin .kaynakca h2 {
    font-size: 22px;
    margin: 0 0 10px;
  }
  .kaynakca ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }
  .kaynakca a {
    border-bottom: 1px solid var(--cizgi);
  }
  .kaynakca a:hover {
    color: var(--vurgu);
  }
  .ilgili,
  .baglantilar,
  .ayni-muze {
    margin-top: 60px;
    border-top: 1px solid var(--cizgi);
    padding-top: 30px;
  }
  .ilgili h2,
  .baglantilar h2,
  .ayni-muze h2 {
    font: 500 34px/1.1 var(--baslik-font);
    margin: 0 0 22px;
  }
  .ilgili ul,
  .baglantilar ul,
  .ayni-muze ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 20px;
  }
  .ilgili a {
    display: block;
    height: 100%;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    transition: border-color 0.2s;
  }
  .ilgili-resmi {
    display: block;
    height: 150px;
    overflow: hidden;
  }
  .ilgili-resmi :global(.mit-gorseli) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ilgili-metni {
    display: block;
    padding: 16px 18px 18px;
  }
  .ilgili-metni strong {
    display: block;
    font: 500 26px/1.1 var(--baslik-font);
  }
  .ilgili-metni span {
    font: italic 400 17px/1.3 var(--baslik-font);
    color: var(--vurgu);
  }
  .baglantilar ul {
    gap: 12px;
  }
  .baglantilar a {
    display: block;
    height: 100%;
    padding: 14px 16px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-left: 2px solid var(--vurgu);
    transition: border-color 0.2s;
  }
  .baglantilar strong {
    display: block;
    font: 500 22px/1.15 var(--baslik-font);
    margin-bottom: 4px;
  }
  .baglantilar a > span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.45;
    color: var(--soluk);
  }
  .ilgili a:hover,
  .baglantilar a:hover {
    border-color: var(--vurgu);
  }
  .kapanis-deseni {
    margin-top: 64px;
  }
  @media (max-width: 900px) {
    .duzen {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .kunye {
      position: static;
    }
    .metin {
      font-size: 19px;
    }
  }
</style>
