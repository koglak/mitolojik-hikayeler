---
import Temel from '../../layouts/Temel.astro';
import SiteBasligi from '../../components/SiteBasligi.astro';
import SiteAltBilgisi from '../../components/SiteAltBilgisi.astro';
import SanatKarti from '../../components/SanatKarti.astro';
import SanatSalonu from '../../components/SanatSalonu.astro';
import MuzeHaritasi from '../../components/MuzeHaritasi.astro';
import DizinSayfalari from '../../components/DizinSayfalari.astro';
import { gorselKokenleri, sanatAciklamasi, sanatAdi, sanatAdresi, sanatEserAdresi, sanatTuruAnahtarlari, sanatTurleri } from '../../lib/sanat';
import { muzeler, sanatEserleriniGetir } from '../../lib/sanatDizini';
import { muzelereGrupla } from '../../lib/sanatSorgu';
import { aramaEsAnlamlari, aramaIcinSadelestir } from '../../lib/aramaMetni';
import { sayfaBoyu } from '../../lib/sayfalama';
import { kirintiVerisi, koleksiyonVerisi } from '../../lib/yapisalVeri';

const ilkSatirKartSayisi = 3;
const eserler = await sanatEserleriniGetir();
const onBaglantilar = gorselKokenleri(eserler.slice(0, ilkSatirKartSayisi));
const muzeGruplari = muzelereGrupla(eserler, muzeler).sort((a, b) => a.muze.ad.localeCompare(b.muze.ad, 'tr'));
const varOlanTurler = sanatTuruAnahtarlari.filter((tur) => eserler.some((eser) => eser.data.tur === tur));
const haritaMuzeleri = muzeGruplari.map(({ muze, eserler: muzeEserleri }) => ({
  ...muze,
  eserler: muzeEserleri.map((eser) => ({ ad: eser.data.ad, adres: sanatEserAdresi(eser.id) })),
}));
const aranacakMetin = ({ data }: (typeof eserler)[number]) => {
  const muze = muzeler[data.muze];
  return aramaIcinSadelestir(
    [
      data.ad,
      data.ozgunAd,
      data.sanatci,
      data.ozet,
      data.tarih,
      sanatTurleri[data.tur],
      muze.ad,
      muze.kent,
      muze.ulke,
      ...(data.aramaTerimleri ?? []),
      ...data.ilgiliTanrilar.flatMap((tanri) => aramaEsAnlamlari[tanri] ?? []),
    ]
      .filter(Boolean)
      .join(' '),
  );
};
const yapisalVeri = [
  koleksiyonVerisi({
    ad: sanatAdi,
    aciklama: sanatAciklamasi,
    yol: sanatAdresi,
    ogeler: eserler.map((eser) => ({ ad: eser.data.ad, yol: sanatEserAdresi(eser.id) })),
  }),
  kirintiVerisi([{ ad: sanatAdi, yol: sanatAdresi }]),
];
---

<Temel baslik={sanatAdi} aciklama={sanatAciklamasi} yapisalVeri={yapisalVeri} onBaglantilar={onBaglantilar}>
  <div class="site-kabugu">
    <SiteBasligi />
    <main data-sayfali-dizin="sanat">
      <header class="giris">
        <div class="giris-metni">
          <h1>{sanatAdi}</h1>
          <p>{sanatAciklamasi}</p>
        </div>
        <div class="giris-resmi"><SanatSalonu kimlik="giris" /></div>
      </header>

      <div class="suzgec" role="search" aria-label="Eserleri süz">
        <label class="arama">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.8"></circle>
            <path d="m16 16 5 5"></path>
          </svg>
          <input type="search" data-kayit-ara placeholder="Eser, sanatçı ya da kent ara" autocomplete="off" aria-label="Sanat eserlerinde ara" />
        </label>
        <label class="muze-secimi">
          <span>Müze</span>
          <select data-sanat-muze>
            <option value="">Bütün müzeler</option>
            {
              muzeGruplari.map(({ kimlik, muze }) => (
                <option value={kimlik}>
                  {muze.ad}, {muze.kent}
                </option>
              ))
            }
          </select>
        </label>
        <div class="turler" role="group" aria-label="Türe göre süz">
          <button type="button" data-sanat-tur="" aria-pressed="true">Tümü</button>
          {
            varOlanTurler.map((tur) => (
              <button type="button" data-sanat-tur={tur} aria-pressed="false">
                {sanatTurleri[tur]}
              </button>
            ))
          }
        </div>
      </div>

      <p class="sonuc" aria-live="polite"><span data-sonuc-sayisi>{eserler.length} eser</span></p>
      <div class="sonuc-yok gizli" data-sonuc-yok>
        <p>Bu seçimle eşleşen eser yok.</p>
        <button type="button" class="dugme-cizgili" data-suzgeci-temizle>Süzgeci temizle</button>
      </div>

      <ul class="eserler">
        {
          eserler.map((eser, sira) => (
            <li
              class:list={{ gizli: sira >= sayfaBoyu }}
              data-sayfa-disi={sira >= sayfaBoyu ? '' : undefined}
              data-aranan={aranacakMetin(eser)}
              data-tur={eser.data.tur}
              data-muze={eser.data.muze}
              data-adres={sanatEserAdresi(eser.id)}
            >
              <SanatKarti eser={eser} oncelikli={sira < ilkSatirKartSayisi} />
            </li>
          ))
        }
      </ul>
      <DizinSayfalari ad="Sanat eserleri sayfaları" />

      <MuzeHaritasi muzeler={haritaMuzeleri} />
    </main>
    <SiteAltBilgisi />
  </div>
</Temel>

<style>
  .giris {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--cizgi);
    margin-bottom: 32px;
  }
  .giris-metni {
    min-width: 0;
  }
  h1 {
    font: 500 clamp(52px, 7vw, 96px) / 0.95 var(--baslik-font);
    letter-spacing: -0.035em;
    margin: 0 0 20px;
  }
  .giris-metni p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--soluk);
    max-width: 30rem;
    margin: 0;
  }
  .giris-resmi {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--cizgi);
  }
  .suzgec {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: 14px;
  }
  .arama,
  .muze-secimi {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    min-height: 52px;
    border: 1px solid var(--cizgi);
    background: var(--yuzey);
    color: var(--soluk);
    transition: border-color 0.2s;
  }
  .arama:focus-within,
  .muze-secimi:focus-within {
    border-color: var(--vurgu);
  }
  .arama input,
  .muze-secimi select {
    flex: 1;
    min-width: 0;
    min-height: 50px;
    border: 0;
    outline: 0;
    background: transparent;
    font: 16px var(--govde-font);
    color: var(--yazi);
  }
  .muze-secimi option {
    background: var(--yuzey);
    color: var(--yazi);
  }
  .arama input::placeholder {
    color: var(--soluk);
  }
  .turler {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .turler button {
    min-height: 44px;
    padding: 0 16px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    font: 500 14px/1 var(--govde-font);
    transition: border-color 0.2s;
  }
  .turler button:hover {
    border-color: var(--vurgu);
  }
  .turler button[aria-pressed='true'] {
    background: var(--vurgu);
    border-color: var(--vurgu);
    color: var(--zemin);
  }
  .sonuc {
    margin: 22px 0 16px;
    font-size: 14px;
    color: var(--soluk);
  }
  .sonuc-yok {
    margin-bottom: 28px;
  }
  .sonuc-yok p {
    font: italic 400 20px/1.4 var(--baslik-font);
    color: var(--soluk);
    margin: 0 0 14px;
  }
  .eserler {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1050px) {
    .eserler {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 740px) {
    .giris {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 36px;
    }
    .suzgec {
      grid-template-columns: minmax(0, 1fr);
    }
    .eserler {
      grid-template-columns: 1fr;
    }
  }
</style>
