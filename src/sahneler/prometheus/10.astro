---
import VazoSahnesi from '../VazoSahnesi.astro';
import Insan from '../figurler/Insan.astro';
import Kartal from '../figurler/Kartal.astro';
import Kaya from '../figurler/Kaya.astro';
import Sutun from '../figurler/Sutun.astro';
import Zincir from '../figurler/Zincir.astro';

const ozellikler = Astro.props;
---

<VazoSahnesi {...ozellikler} slug="prometheus" numara={10}>
  <Sutun x={300} y={256} yukseklik={214} />
  <Insan x={320} y={256} olcek={1.05} durus="yuruyen" onKol="yukari" arkaKol="one" yon="sol" />
  <Zincir x1={292} y1={140} x2={276} y2={160} kirik={true} />
  <Zincir x1={308} y1={170} x2={292} y2={196} kirik={true} />
  <Insan x={70} y={256} olcek={1.1} durus="yuruyen" onKol="one" arkaKol="one" sakalli={true}>
    <path d="M34 -150 C58 -130 58 -90 34 -70" fill="none" stroke="#121010" stroke-width="3.5" />
    <path d="M34 -150 L22 -110 L34 -70" fill="none" stroke="#121010" stroke-width="1.2" />
    <path d="M-14 -144 C-16 -160 4 -166 14 -154 L16 -146 L6 -148 L-2 -142 L-14 -116 L-20 -118 Z" fill="#121010" />
    <path d="M-14 -118 L-26 -60 L-18 -60 L-10 -112 Z" fill="#121010" />
    <path d="M-6 -158 L-4 -152 M2 -160 L4 -154 M-22 -96 L-18 -94 M-20 -80 L-16 -78" stroke="#c8662f" stroke-width="1.3" />
  </Insan>
  <Kartal x={226} y={112} olcek={0.85} kanatlar="inen" />
  <path d="M168 120 L206 112" stroke="#121010" stroke-width="2" />
  <path d="M210 111 L200 108 L202 116 Z" fill="#121010" />
</VazoSahnesi>
