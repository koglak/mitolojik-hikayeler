---
import VazoSahnesi from '../VazoSahnesi.astro';
import Insan from '../figurler/Insan.astro';
import Kral from '../figurler/Kral.astro';
import Okuz from '../figurler/Okuz.astro';

const ozellikler = Astro.props;
---

<VazoSahnesi {...ozellikler} slug="prometheus" numara={3}>
  <Kral x={330} y={256} olcek={1.05} durus="oturan" nitelik="asa" yon="sol" />
  <Okuz x={190} y={256} olcek={1.15} />
  <Insan x={70} y={256} olcek={1.1} durus="yuruyen" onKol="one" arkaKol="geri">
    <path d="M38 -110 L58 -118" stroke="#121010" stroke-width="3" stroke-linecap="round" />
    <path d="M56 -121 L74 -126 L58 -115 Z" fill="#121010" />
  </Insan>
</VazoSahnesi>
