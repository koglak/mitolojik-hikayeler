---
import VazoSahnesi from '../VazoSahnesi.astro';
import Insan from '../figurler/Insan.astro';
import Kral from '../figurler/Kral.astro';
import Alev from '../figurler/Alev.astro';

const ozellikler = Astro.props;
---

<VazoSahnesi {...ozellikler} slug="prometheus" numara={5}>
  <g fill="#121010">
    <rect x="70" y="216" width="70" height="40" />
    <rect x="62" y="208" width="86" height="10" />
  </g>
  <g fill="none" stroke="#c8662f" stroke-width="1.3">
    <path d="M78 226 L132 226 M78 246 L132 246" stroke-dasharray="4 3" />
  </g>
  <g stroke="#121010" stroke-width="4" stroke-linecap="round">
    <path d="M80 204 L120 196 M86 196 L128 206" />
  </g>
  <Alev x={104} y={198} olcek={0.9} />
  <path d="M100 160 C92 146 108 136 100 120 C94 108 104 98 100 86" fill="none" stroke="#121010" stroke-width="2" stroke-dasharray="5 4" />
  <Insan x={36} y={256} olcek={0.85} durus="diz-cokmus" onKol="one" arkaKol="one" />
  <Kral x={290} y={256} olcek={1.15} durus="yuruyen" nitelik="yildirim" yon="sol" />
</VazoSahnesi>
