---
import VazoSahnesi from '../VazoSahnesi.astro';
import Insan from '../figurler/Insan.astro';
import Kartal from '../figurler/Kartal.astro';
import Kaya from '../figurler/Kaya.astro';
import Sutun from '../figurler/Sutun.astro';
import Zincir from '../figurler/Zincir.astro';

const ozellikler = Astro.props;
---

<VazoSahnesi {...ozellikler} slug="prometheus" numara={8}>
  <path d="M0 256 L0 200 L30 168 L52 186 L84 140 L118 182 L140 166 L170 210 L170 256 Z" fill="#121010" />
  <path d="M84 140 L80 170 M30 168 L34 196 M140 166 L136 196" stroke="#c8662f" stroke-width="1.3" fill="none" />
  <Sutun x={250} y={256} yukseklik={214} />
  <Insan x={258} y={256} olcek={1.08} durus="ayakta" onKol="asagi" arkaKol="asagi" yon="sol" />
  <Zincir x1={240} y1={140} x2={276} y2={140} renk="kil" />
  <Zincir x1={242} y1={170} x2={274} y2={170} renk="kil" />
  <Zincir x1={244} y1={232} x2={274} y2={232} renk="kil" />
  <Kaya x={300} y={256} genislik={100} yukseklik={40} />
  <g class="sahne-inis"><Kartal x={130} y={96} olcek={1.05} kanatlar="inen" /></g>
</VazoSahnesi>
